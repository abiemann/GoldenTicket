<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows integration coverage for WPF, vision, the companion host and developer tools.
         Portable rules, application, AI and storage tests live in GoldenTicket.Core.Tests. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- This integration runner loads the win-x64 desktop application. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GoldenTicket.Domain.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/RulesHarness.cs" Link="Support/RulesHarness.cs" />
    <Compile Include="../Shared/ManualFrameTimeProvider.cs" Link="Support/ManualFrameTimeProvider.cs" />
    <Compile Include="../Shared/FakeCameraCapture.cs" Link="Support/FakeCameraCapture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GoldenTicket.Domain\GoldenTicket.Domain.csproj" />
    <ProjectReference Include="..\..\src\GoldenTicket.Application\GoldenTicket.Application.csproj" />
    <ProjectReference Include="..\..\src\GoldenTicket.AI\GoldenTicket.AI.csproj" />
    <ProjectReference Include="..\..\src\GoldenTicket.Persistence\GoldenTicket.Persistence.csproj" />
    <ProjectReference Include="..\..\tools\GoldenTicket.Simulator\GoldenTicket.Simulator.csproj" />
    <ProjectReference Include="..\..\src\GoldenTicket.Desktop\GoldenTicket.Desktop.csproj" />
    <ProjectReference Include="..\..\src\GoldenTicket.CompanionHost\GoldenTicket.CompanionHost.csproj" />
    <ProjectReference Include="..\..\src\GoldenTicket.Vision\GoldenTicket.Vision.csproj" />
  </ItemGroup>

</Project>
