<UserControl x:Class="GoldenTicket.Desktop.Views.GameTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:EmptyStringToVisibilityConverter x:Key="MessageVisibility" />
        <local:PlayerColorBrushConverter x:Key="PlayerColorBrush" />
        <local:CardKindBrushConverter x:Key="CardKindBrush" />
        <local:TrainCountTextConverter x:Key="TrainCountText" />
        <DataTemplate x:Key="SeatCardLayerTemplate">
            <Border Width="36" Height="35" Background="{Binding Fill}"
                    BorderBrush="#FFF0D7A0" BorderThickness="1">
                <TextBlock Text="{Binding Letter}" Foreground="#FFFFE7B0" FontWeight="Bold"
                           FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
        <Style x:Key="SoloDeckButtonStyle" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitArea" Property="BorderBrush" Value="#99E1BD79" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HitArea" Property="BorderBrush" Value="#FFE1BD79" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Seat.Operator}" Value="human" />
                        <Condition Binding="{Binding DataContext.IsSingleHumanGame, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsSoloHumanTurn, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShowSoloOpeningTicketsOnBoard, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DrawCardButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitArea" Property="BorderBrush" Value="#FFE1BD79" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HitArea" Property="BorderBrush" Value="#FFFFE7B0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BoardPaymentCardStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF1A2531" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="CardFrame" Background="{TemplateBinding Background}"
                                BorderBrush="#FFF0D7A0" BorderThickness="2" CornerRadius="5">
                            <Grid>
                                <Border x:Name="SelectionBadge" Background="#FF1A2531"
                                        CornerRadius="3" Width="20" Height="20" Margin="3"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="Collapsed">
                                    <TextBlock Text="✓" Foreground="#FFFFD576" FontSize="13"
                                               FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                                <Border Background="#FFFBEED5" VerticalAlignment="Bottom"
                                        CornerRadius="0,0,3,3" Padding="2">
                                    <ContentPresenter HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardFrame" Property="BorderBrush" Value="#FFFFD576" />
                                <Setter TargetName="CardFrame" Property="BorderThickness" Value="4" />
                                <Setter TargetName="SelectionBadge" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardFrame" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardFrame" Property="BorderBrush" Value="#FFFFE7B0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GameScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody" Background="#FFD4AC6B" BorderBrush="#FFFFE7B0"
                                BorderThickness="1" CornerRadius="6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#FFFFE7B0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GameScrollPageStyle" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="#FF263441" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Height="14" Background="{TemplateBinding Background}"
                                BorderBrush="#FFB18C52" BorderThickness="1" CornerRadius="7">
                            <Track x:Name="PART_Track" Margin="2" IsDirectionReversed="False"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                  Style="{StaticResource GameScrollPageStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GameScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                                  Style="{StaticResource GameScrollPageStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF101821">
        <Image Source="/GoldenTicket;component/Assets/golden-ticket-snowy-twilight.png"
               Stretch="UniformToFill" Opacity="0.42" IsHitTestVisible="False" />
        <!-- One uniformly scaled scene keeps the board, all seats, and market in frame at every window size. -->
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Margin="8">
            <Canvas x:Name="TableScene" Width="1440" Height="900">
                <Border x:Name="GameBoardFrame" Canvas.Left="270" Canvas.Top="{Binding GameTableBoardTop}" Width="900" Height="562.5"
                        CornerRadius="8" Background="Black" BorderBrush="#FFE1BD79"
                        BorderThickness="3" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="LiveBoardImage" Source="{Binding Camera.GameTablePreview}"
                               Stretch="Fill" AutomationProperties.Name="Live cropped board" />
                        <Viewbox Stretch="Fill" IsHitTestVisible="False"
                                 Visibility="{Binding ShowDestinationMarkersOnBoard, Converter={StaticResource BoolToVisibility}}">
                            <Grid Width="960" Height="600"
                                  Visibility="{Binding Camera.GameTablePreview, Converter={StaticResource NullToVisibility}}">
                                <ItemsControl x:Name="DestinationLines" Width="960" Height="600"
                                              ItemsSource="{Binding BoardDestinationLines}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="960" Height="600"
                                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                      Stroke="#A0101822" StrokeThickness="5" />
                                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                      Stroke="#F0FFD576" StrokeThickness="2.5" StrokeDashArray="3,3"
                                                      StrokeDashCap="Round" />
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl x:Name="DestinationCityMarkers" Width="960" Height="600"
                                              ItemsSource="{Binding BoardDestinationMarkers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding Diameter}" Height="{Binding Diameter}"
                                                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                                                  AutomationProperties.Name="{Binding CityName}">
                                                <Ellipse Stroke="#F01A2531" StrokeThickness="8" />
                                                <Ellipse Stroke="#FFFFD576" StrokeThickness="5" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                        <!-- Route coordinates share the same upright 960 x 600 crop as the live board. -->
                        <Viewbox Stretch="Fill" IsHitTestVisible="False"
                                 Visibility="{Binding Game.ShowPlacementTarget, Converter={StaticResource BoolToVisibility}}">
                            <Canvas Width="960" Height="600">
                                <ItemsControl x:Name="PlacementTargetMarkers" Width="960" Height="600"
                                              ItemsSource="{Binding Game.PlacementTargets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="32" Height="32"
                                                  AutomationProperties.Name="{Binding Description}">
                                                <Grid.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="PlacementPulseRing"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.95" To="0.28" Duration="0:0:1.15" AutoReverse="True" />
                                                                <DoubleAnimation Storyboard.TargetName="PlacementPulseRing"
                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 From="0.75" To="1.24" Duration="0:0:1.15" AutoReverse="True" />
                                                                <DoubleAnimation Storyboard.TargetName="PlacementPulseRing"
                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 From="0.75" To="1.24" Duration="0:0:1.15" AutoReverse="True" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Grid.Triggers>
                                                <Ellipse x:Name="PlacementPulseRing" Width="26" Height="26"
                                                         Fill="#48FFD65C" Stroke="#FFFFD65C" StrokeThickness="2.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform CenterX="13" CenterY="13" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse Width="15" Height="15" Stroke="#FF523411" StrokeThickness="1.2">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush Center="0.34,0.29" GradientOrigin="0.3,0.25" RadiusX="0.7" RadiusY="0.7">
                                                            <GradientStop Color="#FFFFFFB7" Offset="0" />
                                                            <GradientStop Color="#FFFFD532" Offset="0.48" />
                                                            <GradientStop Color="#FFBB7300" Offset="1" />
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="LiveBoardStatus" Text="{Binding Camera.GameTablePreviewStatus}"
                                   Foreground="#FFFFE7B0" FontSize="22" TextAlignment="Center"
                                   TextWrapping="Wrap" Width="680" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Camera.GameTablePreviewStatus, Converter={StaticResource MessageVisibility}}" />
                    </Grid>
                </Border>

                <Border x:Name="HumanGuidancePanel" Canvas.Left="555" Canvas.Top="22" Width="330" Height="150" CornerRadius="10"
                        Background="#F21A2531" BorderBrush="#FFB18C52" BorderThickness="1.5"
                        Padding="16,10" AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding ShowBoardFirstClaimProposal, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="THE GAME TABLE" Foreground="#FFFFE7B0" FontSize="21"
                                   FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="GuidancePhaseText" Text="{Binding Game.GuidanceTurn}" Foreground="#FFDCC18A" FontSize="15"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="GuidanceSeatText" Text="{Binding Game.GuidanceSeat}" Foreground="White" FontSize="18"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="GuidanceInstructionText" Text="{Binding Game.GuidanceInstruction}" Foreground="#FFF8EEDC" FontSize="13"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxHeight="65" />
                    </StackPanel>
                </Border>

                <Border x:Name="BoardFirstClaimPanel" Canvas.Left="370" Canvas.Top="10"
                        Width="700" Height="218" CornerRadius="10" Padding="14,8"
                        Visibility="{Binding ShowBoardFirstClaimProposal, Converter={StaticResource BoolToVisibility}}"
                        Background="#F51A2531" BorderBrush="#FFE1BD79" BorderThickness="2"
                        AutomationProperties.LiveSetting="Polite">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="80" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Your route was detected" Foreground="#FFFFE7B0"
                                   FontSize="19" FontWeight="Bold" TextAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="{Binding BoardFirstProposal.RouteText}" Foreground="White"
                                   FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,1,0,1" />
                        <TextBlock Grid.Row="2" Text="Choose which cards to spend. Claiming the route uses your turn."
                                   Foreground="#FFF8EEDC" FontSize="11" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,3" />
                        <ScrollViewer Grid.Row="3" Height="76" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                                      PreviewMouseWheel="OnHorizontalScrollWheel">
                            <ItemsControl ItemsSource="{Binding BoardFirstProposal.Cards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Content="{Binding Kind}" Width="86" Height="58"
                                                      Margin="0,0,6,0" Style="{StaticResource BoardPaymentCardStyle}"
                                                      Background="{Binding Kind, Converter={StaticResource CardKindBrush}}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding Kind}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="4" Text="{Binding BoardFirstProposal.SelectionFeedback}"
                                   Foreground="#FFFFE7B0" FontSize="10" TextAlignment="Center" />
                        <Grid Grid.Row="5" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="If this is the wrong route, remove the pieces to clear the suggestion."
                                       Foreground="#FFDCC18A" FontSize="10" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="OK" Width="76" Height="32" Margin="0"
                                    HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding BoardFirstProposal.CanConfirmPayment}"
                                    Command="{Binding ConfirmBoardFirstClaimCommand}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ScoreMarkerDetectionPanel" Canvas.Left="510" Canvas.Top="478"
                        Width="420" CornerRadius="10" Padding="13"
                        Visibility="{Binding ShowScoreMarkerDetectionPrompt, Converter={StaticResource BoolToVisibility}}"
                        Background="#F51A2531" BorderBrush="#FFE1BD79" BorderThickness="2"
                        AutomationProperties.LiveSetting="Polite">
                    <StackPanel>
                        <TextBlock Text="Move the scoring marker" Foreground="#FFFFE7B0"
                                   FontSize="17" FontWeight="Bold" TextAlignment="Center" />
                        <TextBlock Text="The camera will continue automatically when it sees the marker at the required score."
                                   Foreground="#FFF8EEDC" FontSize="11" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Canvas.Left="1180" Canvas.Top="96" Width="250" Height="147" CornerRadius="9"
                        Visibility="{Binding Game.ShowManualPlacementControls, Converter={StaticResource BoolToVisibility}}"
                        Background="#F21A2531" BorderBrush="#FFB18C52" BorderThickness="1.5"
                        Padding="11" AutomationProperties.LiveSetting="Polite">
                    <StackPanel>
                        <TextBlock Text="Check this placement"
                                   Foreground="#FFFFE7B0" FontSize="14" FontWeight="Bold"
                                   TextAlignment="Center" />
                        <TextBlock Text="This route is not yet calibrated for camera confirmation."
                                   Foreground="#FFF8EEDC" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,4,0,5" />
                        <CheckBox Content="I checked the whole board"
                                  IsChecked="{Binding Table.WholeBoardAcknowledged}"
                                  Foreground="#FFF8EEDC" FontSize="11" />
                        <Button Content="CONFIRM TRAINS" Height="29" Margin="0,6,0,0"
                                IsEnabled="{Binding Table.WholeBoardAcknowledged}"
                                Command="{Binding ConfirmPlacementCommand}"
                                Background="#FF69412F" Foreground="#FFFFE7B0"
                                BorderBrush="#FFF0D7A0" BorderThickness="1.5" />
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="PlayerStations" ItemsSource="{Binding Game.TableSeats}"
                              Width="1440" Height="900">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="250" Height="160" CornerRadius="10" Background="#F01A2531"
                                    BorderBrush="#FFD4AC6B" BorderThickness="2" Padding="9">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="68" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="21" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="66" Height="66" CornerRadius="5" ClipToBounds="True"
                                            BorderBrush="{Binding Seat.Color, Converter={StaticResource PlayerColorBrush}}"
                                            BorderThickness="3" HorizontalAlignment="Center">
                                        <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock x:Name="TrainsRemainingText" Grid.Column="1" Margin="10,0,0,0"
                                               HorizontalAlignment="Left" Foreground="#FFF8EEDC" FontSize="11">
                                        <Run Text="{Binding Seat.TrainsRemaining, Converter={StaticResource TrainCountText}}" />
                                    </TextBlock>
                                    <ItemsControl Grid.Column="1" Width="50" Height="42" HorizontalAlignment="Center"
                                                  VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                  ItemsSource="{Binding TrainCardLayers}"
                                                  ItemTemplate="{StaticResource SeatCardLayerTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <ItemsControl Grid.Column="2" Width="50" Height="42" HorizontalAlignment="Center"
                                                  VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                  ItemsSource="{Binding DestinationLayers}"
                                                  ItemTemplate="{StaticResource SeatCardLayerTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Seat.DisplayName}"
                                               Foreground="#FFFFE7B0" FontSize="12" FontWeight="Bold"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Train cards" Margin="10,0,0,0"
                                               HorizontalAlignment="Left" Foreground="#FFF8EEDC" FontSize="11" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Destinations"
                                               Foreground="#FFF8EEDC" FontSize="11" TextAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Foreground="#FFE6D9C3"
                                               FontSize="12" TextAlignment="Center">
                                        <Run Text="{Binding Seat.Score}" /><Run Text=" pts" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Seat.CardCount}"
                                               Foreground="#FFE6D9C3" FontSize="12" TextAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Seat.TicketCount}"
                                               Foreground="#FFE6D9C3" FontSize="12" TextAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Seat.LastAction}"
                                               ToolTip="{Binding Seat.LastAction}" Foreground="#FFDCC18A"
                                               FontSize="10" TextAlignment="Center" TextWrapping="Wrap"
                                               Height="26" LineHeight="13" VerticalAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="1" Width="54" Height="44"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                            Style="{StaticResource SoloDeckButtonStyle}"
                                            ToolTip="Show your train cards" AutomationProperties.Name="Show your train cards"
                                            Command="{Binding DataContext.ToggleSoloTrainCardsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Row="0" Grid.Column="2" Width="54" Height="44"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                            Style="{StaticResource SoloDeckButtonStyle}"
                                            ToolTip="Show your destinations" AutomationProperties.Name="Show your destinations"
                                            Command="{Binding DataContext.ToggleSoloDestinationsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- A compact solo hand stays at the table. Its position follows the human station. -->
                <Border x:Name="SoloCardPanel" Canvas.Left="10" Canvas.Top="478" Width="250"
                        MaxHeight="214" CornerRadius="9" Background="#F51A2531"
                        BorderBrush="#FFD4AC6B" BorderThickness="2" Padding="8"
                        Visibility="{Binding ShowSoloCardPanel, Converter={StaticResource BoolToVisibility}}"
                        IsVisibleChanged="OnSoloCardPanelVisibilityChanged">
                    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="Your train cards" Foreground="#FFFFE7B0" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Visibility="{Binding ShowSoloTrainCards, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Your destinations" Foreground="#FFFFE7B0" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Visibility="{Binding ShowSoloDestinations, Converter={StaticResource BoolToVisibility}}" />
                        <ScrollViewer Height="91" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto" PanningMode="HorizontalOnly"
                                      PreviewMouseWheel="OnHorizontalScrollWheel" Margin="0,5,0,0"
                                      Visibility="{Binding ShowSoloTrainCards, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl x:Name="SoloTrainCards" ItemsSource="{Binding SoloTrainCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="101" Height="67" Margin="3" CornerRadius="4"
                                                Background="{Binding Kind, Converter={StaticResource CardKindBrush}}"
                                                BorderBrush="#FFF0D7A0" BorderThickness="2">
                                            <TextBlock Text="{Binding Label}" Foreground="#FF1A2531" FontSize="11"
                                                       FontWeight="Bold" TextAlignment="Center" TextWrapping="NoWrap"
                                                       VerticalAlignment="Bottom" Background="#EEF5EAD5" Padding="2" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <ScrollViewer Height="142" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Auto" PanningMode="HorizontalOnly"
                                      PreviewMouseWheel="OnHorizontalScrollWheel" Margin="0,5,0,0"
                                      Visibility="{Binding ShowSoloDestinations, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl x:Name="SoloDestinationCards" ItemsSource="{Binding SoloDestinationCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="106" Height="118" Margin="2,1,2,3" Padding="4,3"
                                                CornerRadius="4" Background="#FFFBEED5"
                                                BorderBrush="#FFD4AC6B" BorderThickness="1.5"
                                                ToolTip="{Binding Description}"
                                                AutomationProperties.Name="{Binding Description}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="27" />
                                                    <RowDefinition Height="14" />
                                                    <RowDefinition Height="27" />
                                                    <RowDefinition Height="8" />
                                                    <RowDefinition Height="15" />
                                                    <RowDefinition Height="13" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding Origin}" Foreground="#FF31241D"
                                                           FontSize="10" FontWeight="SemiBold" TextAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <Path Grid.Row="1" Data="M 0,0 L 5,5 L 10,0"
                                                      Stroke="#FF77512F" StrokeThickness="1.5"
                                                      Width="10" Height="5" Stretch="None"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Text="{Binding Destination}" Foreground="#FF31241D"
                                                           FontSize="10" FontWeight="SemiBold" TextAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="4" Foreground="#FF77512F" FontSize="10"
                                                           HorizontalAlignment="Center" TextWrapping="NoWrap">
                                                    <Run Text="{Binding Points, Mode=OneWay}" /><Run Text=" points" />
                                                </TextBlock>
                                                <TextBlock Grid.Row="5" Text="Completed" Foreground="#FF2B724A" FontSize="9"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           Visibility="{Binding Completed, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border x:Name="SoloTicketOfferPanel" Canvas.Left="270" Canvas.Top="690" Width="900" Height="194"
                        CornerRadius="9" Background="#F51A2531" BorderBrush="#FFE1BD79"
                        BorderThickness="2" Padding="10,5"
                        Visibility="{Binding ShowSoloTicketOffer, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.LiveSetting="Polite">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Your new destinations" Foreground="#FFFFE7B0" FontSize="17"
                                   FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Row="1" Foreground="#FFF8EEDC" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,1,0,3">
                            <Run Text="Select the destinations to keep. Keep at least " />
                            <Run Text="{Binding SoloTicketMinimumKeep, Mode=OneWay}" /><Run Text="." />
                        </TextBlock>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding SoloTicketOffer}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Keep}" Width="278" Margin="4,0"
                                              VerticalAlignment="Center" Cursor="Hand">
                                        <Border Width="251" Height="90" CornerRadius="5" Padding="5"
                                                Background="#FFFBEED5" BorderBrush="#FFD4AC6B"
                                                BorderThickness="2">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}" Foreground="#FF31241D"
                                                           FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Foreground="#FF77512F" FontSize="11"
                                                           TextAlignment="Center" Margin="0,3,0,0">
                                                    <Run Text="{Binding Points, Mode=OneWay}" /><Run Text=" points" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SoloTicketOfferMessage}" Foreground="#FFFFD576"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="KEEP SELECTED" Width="168" Height="29"
                                    Command="{Binding KeepSoloTicketsCommand}"
                                    Background="#FF69412F" Foreground="#FFFFE7B0"
                                    BorderBrush="#FFF0D7A0" BorderThickness="1.5" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="DrawPilesPanel" Canvas.Left="14" Canvas.Top="768" Width="236" Height="116" CornerRadius="9"
                        Visibility="{Binding ShowDrawPanels, Converter={StaticResource BoolToVisibility}}"
                        Background="#EF1A2531" BorderBrush="#FFB18C52" BorderThickness="1.5" Padding="9,5">
                    <StackPanel>
                        <TextBlock Text="DRAW PILES" Foreground="#FFFFE7B0" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Grid Margin="0,0,14,0">
                                <StackPanel>
                                <Border Width="50" Height="54" Background="#FF9B613C" BorderBrush="#FFF0D7A0"
                                        BorderThickness="2" CornerRadius="3">
                                    <TextBlock Text="T" Foreground="#FFFFE7B0" FontSize="25" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="TRAIN" Foreground="#FFF8EEDC" FontSize="10"
                                           HorizontalAlignment="Center" />
                                </StackPanel>
                                <Button Style="{StaticResource DrawCardButtonStyle}"
                                        ToolTip="Draw a train card from the pile"
                                        AutomationProperties.Name="Draw a train card from the pile"
                                        Command="{Binding DrawSoloBlindCommand}" />
                            </Grid>
                            <Grid>
                                <StackPanel>
                                <Border Width="50" Height="54" Background="#FF648AA7" BorderBrush="#FFF0D7A0"
                                        BorderThickness="2" CornerRadius="3">
                                    <TextBlock Text="D" Foreground="#FFFFE7B0" FontSize="25" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="DESTINATIONS" Foreground="#FFF8EEDC" FontSize="10"
                                           HorizontalAlignment="Center" />
                                </StackPanel>
                                <Button Style="{StaticResource DrawCardButtonStyle}"
                                        ToolTip="Draw destination tickets"
                                        AutomationProperties.Name="Draw destination tickets"
                                        Command="{Binding DrawSoloTicketsCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="FaceUpMarketPanel" Canvas.Left="975" Canvas.Top="768" Width="450" Height="116" CornerRadius="9"
                        Visibility="{Binding ShowDrawPanels, Converter={StaticResource BoolToVisibility}}"
                        Background="#EF1A2531" BorderBrush="#FFB18C52" BorderThickness="1.5" Padding="9,5">
                    <StackPanel>
                        <TextBlock Text="FACE-UP TRAIN CARDS" Foreground="#FFFFE7B0" FontSize="14"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Table.Market}" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DrawCardButtonStyle}"
                                            Command="{Binding DataContext.DrawSoloFaceUpCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Label, StringFormat=Draw face-up {0} train card}"
                                            ToolTip="{Binding Label, StringFormat=Draw face-up {0} train card}">
                                        <Border Width="80" Height="71" CornerRadius="4" Margin="3,0"
                                                Background="{Binding Kind, Converter={StaticResource CardKindBrush}}"
                                                BorderBrush="#FFF0D7A0" BorderThickness="2">
                                            <TextBlock Text="{Binding Label}" Foreground="#FF1A2531" FontSize="11"
                                                       FontWeight="Bold" TextAlignment="Center" TextWrapping="NoWrap"
                                                       VerticalAlignment="Bottom" Background="#DDF5EAD5" Padding="2" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Canvas>
        </Viewbox>

    </Grid>
</UserControl>
