<UserControl x:Class="GoldenTicket.Desktop.Views.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop"
             xmlns:vm="clr-namespace:GoldenTicket.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:CameraViewModel}" mc:Ignorable="d">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:PlayerColorBrushConverter x:Key="PlayerColorBrush" />
        <Style x:Key="CornerSelectionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Content" Value="Select four board corners" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectingCorners}" Value="True">
                    <Setter Property="Content" Value="Restart corner selection" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Display}" Text="Board camera" />
                    <TextBlock Text="Connect the overhead camera, frame the whole board, and save a board photo crop. Route placement uses explicit manual confirmation." TextWrapping="Wrap" />
                    <WrapPanel Margin="0,12,0,0">
                        <ComboBox Width="265" MinHeight="34" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" AutomationProperties.Name="Overhead camera" />
                        <Button Content="Refresh cameras" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <ComboBox Width="265" MinHeight="34" ItemsSource="{Binding Preferences}" SelectedItem="{Binding SelectedPreference}" DisplayMemberPath="Label" AutomationProperties.Name="Camera resolution preference" />
                        <Button Content="Start preview" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Stop camera" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                    <TextBlock Margin="0,10,0,0" Text="{Binding Status}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Action.Primary}" FontWeight="SemiBold" Text="{Binding Problem}" TextWrapping="Wrap" />
                    <WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding FormatText}" Margin="0,0,24,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding ComputeStatus}" ToolTip="{Binding ComputeExplanation}" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <ComboBox Width="265" MinHeight="34" ItemsSource="{Binding ProcessorModes}" SelectedItem="{Binding SelectedProcessor}"
                                  DisplayMemberPath="Label" AutomationProperties.Name="Image processor preference" />
                        <Button Content="Apply processor" Command="{Binding ApplyProcessorCommand}" Style="{StaticResource SecondaryButton}"
                                IsEnabled="{Binding CanApplyProcessor}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ProcessingText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="Enhanced 4K preview" IsChecked="{Binding UseEnhancedPreview}" Margin="0,0,22,0"
                                  ToolTip="Uncheck to compare the original camera frame. Analysis continues on the enhanced image." />
                        <CheckBox Content="Show piece outlines" IsChecked="{Binding ShowPieceOutlines}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,12">
                <WrapPanel Margin="0,0,0,4">
                    <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Zoom out camera preview" ToolTip="Zoom out (−)" />
                    <TextBlock x:Name="ZoomText" Text="100%" MinWidth="64" VerticalAlignment="Center" TextAlignment="Center"
                               AutomationProperties.Name="Camera preview zoom" />
                    <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Zoom in camera preview" ToolTip="Zoom in (+)" />
                    <Button x:Name="FitPreviewButton" Content="Fit" Click="FitPreview_Click" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Fit whole camera image" ToolTip="Show the whole camera image (0)" />
                    <CheckBox x:Name="PanPreviewToggle" Content="Pan" VerticalAlignment="Center" Margin="12,0"
                              Checked="PanPreview_Changed" Unchecked="PanPreview_Changed"
                              ToolTip="Always pan when dragging, including over numbered crop corners" />
                    <Button x:Name="DetectCornersPreviewButton" Content="Detect board corners" Command="{Binding DetectBoardCornersCommand}"
                            IsEnabled="{Binding CanDetectBoardCorners}" Style="{StaticResource PrimaryButton}"
                            ToolTip="Use the local ML model to select all four outer board corners. Drag the handles to refine the result." />
                    <Button x:Name="SelectCornersPreviewButton" Command="{Binding BeginCornerSelectionCommand}"
                            Style="{StaticResource CornerSelectionButton}" Margin="12,0,0,0" />
                </WrapPanel>
                <TextBlock x:Name="CornerModelStatus" Text="{Binding CornerDetectionStatus}" TextWrapping="Wrap"
                           Style="{StaticResource Caption}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="CornerSelectionPrompt" Text="{Binding CropText}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,4,0,4" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="PreviewProblemText" Text="{Binding Problem}" Foreground="{StaticResource Action.Primary}"
                           FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="When zoomed in, drag the image to move around. During corner selection, click to place the next corner; drag a numbered handle to adjust it. Pan mode, Space + drag, or the middle mouse button can pan over handles too. Zoom: + / − or Ctrl + mouse wheel. Fit shows the whole image. Press 1–4 to find a corner." />
                <Border Background="#251A16" CornerRadius="8" Padding="8" Height="465">
                <Grid x:Name="PreviewArea" SizeChanged="PreviewArea_SizeChanged" ClipToBounds="True" Background="Transparent"
                      PreviewMouseWheel="PreviewArea_MouseWheel"
                      PreviewMouseDown="PreviewArea_MouseDown" PreviewMouseUp="PreviewArea_MouseUp"
                      MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                      MouseMove="PreviewImage_MouseMove" MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"
                      LostMouseCapture="PreviewImage_LostMouseCapture">
                    <Image x:Name="PreviewImage" Source="{Binding Preview, NotifyOnTargetUpdated=True}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                           TargetUpdated="PreviewImage_TargetUpdated"
                           Focusable="True" KeyboardNavigation.IsTabStop="True"
                           KeyDown="PreviewImage_KeyDown"
                           KeyUp="PreviewImage_KeyUp" LostKeyboardFocus="PreviewImage_LostKeyboardFocus"
                           AutomationProperties.Name="Live overhead camera preview. ML selects the corners when the camera starts; Detect board corners tries again. Select four board corners places them manually. Zoom with plus or minus, or Ctrl and mouse wheel. Zero fits the whole image. When zoomed in, drag the image to pan. During selection, click to place the next corner. Drag numbered corners to adjust them, or hold Space and drag to pan over them. Press 1 to 4 to find a corner, then arrow keys to adjust it. Hold Shift for larger steps. During selection, Enter leaves corner editing; use arrows and Enter to place the next corner." />
                    <TextBlock Text="Camera preview is off" FontSize="22" Foreground="{StaticResource Text.OnDark}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <Canvas x:Name="DetectionOverlay" IsHitTestVisible="False" />
                    <Canvas x:Name="CornerOverlay" IsHitTestVisible="False" />
                </Grid>
                </Border>
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Camera framing reference" />
                        <TextBlock Text="Clear hands and check the board before setting a reference. If the camera moves, return it to the original view. A changed board or lighting may require a new reference." TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,8">
                            <Button Content="Set scene reference" Command="{Binding SetReferenceCommand}" Style="{StaticResource SecondaryButton}" />
                            <Button Content="Clear reference" Command="{Binding ClearReferenceCommand}" Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding ComparisonText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="This comparison cannot identify train colors, route occupancy or a motionless hand. Manual verification remains required even when the scene is stable." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Board photo crop" />
                        <TextBlock Text="{Binding CropText}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,8">
                            <Button Content="Detect board corners" Command="{Binding DetectBoardCornersCommand}" IsEnabled="{Binding CanDetectBoardCorners}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                            <Button Command="{Binding BeginCornerSelectionCommand}" Style="{StaticResource CornerSelectionButton}" Margin="0,0,8,8" />
                            <Button Content="Export board photo…" Command="{Binding ExportSnapshotCommand}" IsEnabled="{Binding CanExportPhoto}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="Drag any numbered corner before or after the crop is selected. Keyboard: focus the preview, press 1–4 to choose a corner, then use arrows (Shift for larger steps). When placing corners, Enter leaves editing; arrows and Enter place the next corner." TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Image Source="{Binding BoardPreview}" Height="150" Stretch="Uniform" AutomationProperties.Name="Selected board crop preview" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LastExportPath}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Piece outlines" />
                    <TextBlock TextWrapping="Wrap" Text="Check the selected board outline and clear your hands. The local ML model finds pieces in the current image. White rectangles mark trains; white squares mark score markers. An empty-board photo is not needed." />
                    <WrapPanel Margin="0,10,0,8">
                        <Button Content="Reload ML model" Command="{Binding ReloadPieceModelCommand}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding CanReloadPieceModel}"
                                ToolTip="Reload the installed local model. Uses CPU when CPU only is selected above; otherwise prefers GPU." />
                    </WrapPanel>
                    <TextBlock x:Name="PieceModelStatus" Text="{Binding ModelStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding DetectionText}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="Score track" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <ItemsControl x:Name="MarkerScoresList" ItemsSource="{Binding MarkerScores}" AutomationProperties.Name="Score track values by marker color">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Ornament}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,8,8" MinWidth="132"
                                        AutomationProperties.Name="{Binding AccessibleText}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14" Fill="{Binding Color, Converter={StaticResource PlayerColorBrush}}"
                                                     Stroke="{DynamicResource Text.Primary}" StrokeThickness="1" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Color}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ValueText}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MarkerScoreStatus}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" Text="Reads marker colors and printed track positions on the upright USA board. Keep the crop close to its outer edge. Full laps are not inferred; these readings do not change game scores." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Text="This is an experimental model. Check for missing, extra or merged outlines, especially on touching pieces and glare. Train colors and route ownership are not read. Outlines do not change the game." />
                    <TextBlock Text="Review note (optional)" Margin="0,12,0,4" />
                    <TextBox x:Name="DetectionReviewNoteBox" Text="{Binding DetectionReviewNote, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="2000" TextWrapping="Wrap" MinHeight="44" AcceptsReturn="True"
                             AutomationProperties.Name="What did the ML outlines miss or get wrong?" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="SaveDetectionExampleButton" Content="Save detection example…" Command="{Binding SaveDetectionExampleCommand}"
                                IsEnabled="{Binding CanSaveDetectionExample}" Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Saves the exact analyzed board image, model predictions and your note in one local ZIP for review. Nothing is uploaded or automatically added to training." />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding LastDetectionExamplePath}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Expander Grid.Row="4" Header="Camera formats and setup guidance" Margin="0,12,0,0">
                <StackPanel Margin="10">
                    <TextBlock TextWrapping="Wrap" Text="Use a rigid stand, keep the USB cable slack, and fit the board into the image with even lighting. On Pixel, choose Webcam in USB preferences. If another app owns the camera, close it or try Shared mode. No microphone is opened." />
                    <TextBlock Text="Formats reported by this camera:" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <ItemsControl ItemsSource="{Binding AvailableFormats}" />
                </StackPanel>
            </Expander>
        </Grid>
    </ScrollViewer>
</UserControl>
