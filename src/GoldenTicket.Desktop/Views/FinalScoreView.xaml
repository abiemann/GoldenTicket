<UserControl x:Class="GoldenTicket.Desktop.Views.FinalScoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop"
             xmlns:vm="clr-namespace:GoldenTicket.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <local:PlayerColorBrushConverter x:Key="PlayerColorBrush" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:TrainCountTextConverter x:Key="TrainCountText" />
    </UserControl.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource Display}" Text="Final scores" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" Text="{Binding FinalSummary}" />

            <ItemsControl ItemsSource="{Binding FinalScores}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18" Height="18" CornerRadius="9" Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                            Background="{Binding Color, Converter={StaticResource PlayerColorBrush}}" />
                                    <TextBlock Text="{Binding Symbol}" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SeatName}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="  ·  winner" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource Status.Success}"
                                               Visibility="{Binding IsWinner, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Margin="16,0,0,0"
                                               Foreground="{StaticResource Action.Primary}">
                                        <Run Text="{Binding Total, Mode=OneWay}" /><Run Text=" points" />
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Margin="0,8,0,0">
                                    <Run Text="Routes " /><Run Text="{Binding RoutePoints, Mode=OneWay}" /><Run
                                        Text="   ·   destinations +" /><Run Text="{Binding TicketsGained, Mode=OneWay}" /><Run
                                        Text=" / -" /><Run Text="{Binding TicketsLost, Mode=OneWay}" /><Run
                                        Text="   ·   longest-route bonus " /><Run Text="{Binding LongestBonus, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource Caption}" Text="{Binding TicketSummary}" />

                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold">
                                    <Run Text="Longest continuous route: " /><Run
                                        Text="{Binding LongestTrailLength, Mode=OneWay, Converter={StaticResource TrainCountText}}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding WitnessTrail}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Panel}">
                <TextBlock Style="{StaticResource Caption}"
                           Text="The longest continuous route is the exact maximum trail that never reuses a route, computed from confirmed state. The trail shown is the one that achieves it; a tie awards the bonus to every seat that reaches the same length." />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
