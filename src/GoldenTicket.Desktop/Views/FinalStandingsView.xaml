<UserControl x:Class="GoldenTicket.Desktop.Views.FinalStandingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GoldenTicket.Desktop.Views"
             x:Name="Scene" Background="#FF101821">
    <Grid>
        <Image Source="/GoldenTicket;component/Assets/golden-ticket-snowy-twilight.png"
               Stretch="UniformToFill" Opacity="0.5" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform" Margin="22,65,22,22" IsHitTestVisible="False">
            <Border Width="1440" Height="900" CornerRadius="10" BorderThickness="3"
                    BorderBrush="#FFE1BD79" Background="#FF101821" ClipToBounds="True">
                <Image x:Name="FinalBoardImage" Source="{Binding BoardImage, ElementName=Scene}"
                       Stretch="Fill" AutomationProperties.Name="Game board behind final standings" />
            </Border>
        </Viewbox>
        <Border Background="#46000912" IsHitTestVisible="False" />
        <views:FinalScoreView x:Name="Standings" />
    </Grid>
</UserControl>
