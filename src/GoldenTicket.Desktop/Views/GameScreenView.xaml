<UserControl x:Class="GoldenTicket.Desktop.Views.GameScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop"
             xmlns:views="clr-namespace:GoldenTicket.Desktop.Views"
             xmlns:vm="clr-namespace:GoldenTicket.Desktop.ViewModels"
             Focusable="True" PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:EmptyStringToVisibilityConverter x:Key="MessageVisibility" />
        <local:ScreenVisibilityConverter x:Key="ScreenVisibility" />

        <Style x:Key="GameChoiceButton" TargetType="Button">
            <Setter Property="Background" Value="#DB17212C" />
            <Setter Property="Foreground" Value="#FFF8EEDC" />
            <Setter Property="BorderBrush" Value="#99DFB75C" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#E14E2F2B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameSeatButton" TargetType="Button" BasedOn="{StaticResource GameChoiceButton}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#E14E2F2B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFE7D8B2" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD576" />
                    <Setter Property="BorderThickness" Value="4" />
                    <Setter Property="Background" Value="#EC522D26" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WelcomeStartButton" TargetType="Button" BasedOn="{StaticResource GameChoiceButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Game.IsStartSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD576" />
                    <Setter Property="BorderThickness" Value="4" />
                    <Setter Property="Background" Value="#EC522D26" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WelcomeReloadButton" TargetType="Button" BasedOn="{StaticResource GameChoiceButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Game.IsReloadSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD576" />
                    <Setter Property="BorderThickness" Value="4" />
                    <Setter Property="Background" Value="#EC522D26" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GamePlayButton" TargetType="Button" BasedOn="{StaticResource GameChoiceButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Game.IsPlaySelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFD576" />
                    <Setter Property="BorderThickness" Value="4" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EC522D26" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GameSetupActionButton" TargetType="Button" BasedOn="{StaticResource GameChoiceButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EC522D26" />
                    <Setter Property="BorderBrush" Value="#FFFFD576" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GameCameraPickerItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFF8EEDC" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemFrame" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemFrame" Property="Background" Value="#663D3027" />
                                <Setter Property="Foreground" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemFrame" Property="Background" Value="#EC522D26" />
                                <Setter Property="Foreground" Value="#FFFFE7B0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GameCameraPicker" TargetType="ComboBox">
            <Setter Property="Background" Value="#DB17212C" />
            <Setter Property="Foreground" Value="#FFF8EEDC" />
            <Setter Property="BorderBrush" Value="#99DFB75C" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GameCameraPickerItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="PickerFrame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      VerticalAlignment="Center" Margin="13,0,38,0"
                                                      IsHitTestVisible="False" />
                                    <Path Data="M 0,0 L 6,6 L 12,0" Stroke="#FFFFD576" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,15,0" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PickerFrame}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Slide">
                                <Border Background="#F21B2733" BorderBrush="#FFD6AD5C"
                                        BorderThickness="2" CornerRadius="8" Padding="3"
                                        Width="{Binding ActualWidth, ElementName=PickerFrame}">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerFrame" Property="BorderBrush" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PickerFrame" Property="BorderBrush" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="PickerFrame" Property="Background" Value="#EC522D26" />
                                <Setter TargetName="PickerFrame" Property="BorderBrush" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PickerFrame" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PhoneShortcutButton" TargetType="Button" BasedOn="{StaticResource GameChoiceButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CanConnectPhone}" Value="True" />
                        <Condition Binding="{Binding GameplayScreen}" Value="{x:Static vm:Screen.Table}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GameBackArrowButton" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Canvas Width="64" Height="54" Background="Transparent"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="ArrowBody"
                                  Data="M 27,8.3 L 3,27 L 27,45.7 L 27,36.35 L 60,36.35 L 60,17.65 L 27,17.65 Z"
                                  Fill="Transparent" Stroke="#FFD6AD5C" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowBody" Property="Fill" Value="#EC522D26" />
                                <Setter TargetName="ArrowBody" Property="Stroke" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ArrowBody" Property="Fill" Value="#E14E2F2B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ArrowBody" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeSettingsButton" TargetType="Button" BasedOn="{StaticResource GameChoiceButton}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EC522D26" />
                    <Setter Property="BorderBrush" Value="#FFFFD576" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#101821">
        <Image Source="/GoldenTicket;component/Assets/golden-ticket-snowy-twilight.png"
               Stretch="UniformToFill" IsHitTestVisible="False" />

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="34,24,0,34"
                Width="470" Padding="22" CornerRadius="12"
                Background="#DE151E29" BorderBrush="#FFD6AD5C" BorderThickness="1"
                Visibility="{Binding Game.IsWelcome, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Choose a journey" Foreground="#FFFFE7B0" FontSize="24"
                           FontWeight="SemiBold" Margin="0,0,0,14" />
                <Button x:Name="StartButton" Style="{StaticResource WelcomeStartButton}"
                        Content="Start a new game" FontSize="20" MinHeight="58" Margin="0,0,0,10"
                        MouseEnter="Start_MouseEnter" Click="Welcome_Click"
                        AutomationProperties.Name="Start a new game" />
                <Button x:Name="ReloadButton" Style="{StaticResource WelcomeReloadButton}"
                        Content="Reload the previous game" FontSize="20" MinHeight="58"
                        MouseEnter="Reload_MouseEnter" Click="Welcome_Click"
                        Visibility="{Binding Game.HasPreviousGame, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.Name="Reload the previous game" />
                <Grid Margin="0,12,0,0">
                    <TextBlock Text="Use ↑ ↓ and Enter, or point and click"
                               Foreground="#FFE6D9C3" FontSize="13"
                               VerticalAlignment="Bottom" Margin="2,0,0,4" />
                    <Button x:Name="SettingsButton" Style="{StaticResource WelcomeSettingsButton}"
                            Content="Settings"
                            HorizontalAlignment="Right" Click="Settings_Click" ToolTip="Settings"
                            AutomationProperties.Name="Settings" />
                </Grid>
                <TextBlock Text="{Binding Game.Message}" Foreground="#FFFFD576" Margin="2,10,0,0"
                           Visibility="{Binding Game.Message, Converter={StaticResource MessageVisibility}}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="18"
                 Visibility="{Binding Game.IsSettings, Converter={StaticResource BoolToVisibility}}">
            <Border x:Name="SettingsDialog" Width="610" Padding="22" CornerRadius="12"
                    Background="#EA151E29" BorderBrush="#FFD6AD5C" BorderThickness="1">
                <StackPanel>
                    <Grid Height="54">
                        <TextBlock Text="Settings" Foreground="#FFFFE7B0" FontSize="25"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Display mode" Foreground="#FFFFE7B0" FontSize="18"
                               FontWeight="SemiBold" Margin="0,14,0,6" />
                    <ComboBox Width="400" Height="38" HorizontalAlignment="Left"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding DisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="Display mode">
                        <ComboBoxItem Content="Resizable" Tag="{x:Static vm:DisplayMode.Resizable}" />
                        <ComboBoxItem Content="Full screen" Tag="{x:Static vm:DisplayMode.FullScreen}" />
                    </ComboBox>
                    <TextBlock Text="Webcam" Foreground="#FFFFE7B0" FontSize="18"
                               FontWeight="SemiBold" Margin="0,14,0,6" />
                    <DockPanel LastChildFill="False">
                        <ComboBox x:Name="SettingsCameraPicker" Width="400" Height="38"
                                  ItemsSource="{Binding Camera.Devices}"
                                  SelectedItem="{Binding Camera.SelectedDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" AutomationProperties.Name="Settings webcam" />
                        <Button Content="Refresh" Command="{Binding Camera.RefreshDevicesCommand}"
                                Style="{StaticResource GameSetupActionButton}"
                                Width="95" Height="38" Padding="4" FontSize="15" Margin="10,0,0,0"
                                AutomationProperties.Name="Refresh settings webcams" />
                    </DockPanel>
                    <TextBlock x:Name="SettingsCameraCompatibilityMessage"
                               Text="{Binding Camera.CameraCompatibilityMessage}"
                               Foreground="#FFFFD576" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Camera.HasCameraCompatibilityMessage, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="Camera quality" Foreground="#FFFFE7B0" FontSize="18"
                               FontWeight="SemiBold" Margin="0,14,0,6" />
                    <ComboBox Width="400" Height="38" HorizontalAlignment="Left"
                              ItemsSource="{Binding Camera.Preferences}"
                              SelectedItem="{Binding Camera.SelectedPreference}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Camera quality preference" />
                    <TextBlock Text="The camera uses this quality the next time its preview starts."
                               Foreground="#FFE6D9C3" FontSize="13" Margin="0,5,0,0" />
                    <TextBlock Text="Image processor" Foreground="#FFFFE7B0" FontSize="18"
                               FontWeight="SemiBold" Margin="0,18,0,6" />
                    <ComboBox Width="400" Height="38" HorizontalAlignment="Left"
                              ItemsSource="{Binding Camera.ProcessorModes}"
                              SelectedItem="{Binding Camera.SelectedProcessor}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Image processor preference" />
                    <CheckBox Content="Show Destinations when viewing Train cards"
                              IsChecked="{Binding ShowDestinationsWhenViewingTrainCards, Mode=TwoWay}"
                              Foreground="#FFF8EEDC" Margin="0,10,0,0"
                              AutomationProperties.Name="Show Destinations when viewing Train cards" />
                    <TextBlock Text="These settings use the same camera as the game and utility screens."
                               Foreground="#FFE6D9C3" FontSize="13" Margin="0,20,0,0" />
                    <Button x:Name="SettingsOkButton" Content="OK" Width="110" Height="48"
                            HorizontalAlignment="Right" Margin="0,20,0,0"
                            Style="{StaticResource GameSetupActionButton}"
                            IsEnabled="{Binding Camera.CanApplyProcessor}"
                            Click="SettingsOk_Click"
                            AutomationProperties.Name="Apply settings and return to game menu" />
                </StackPanel>
            </Border>
        </Viewbox>

        <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                 VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,16,16,25"
                 Visibility="{Binding Game.IsCharacterSelection, Converter={StaticResource BoolToVisibility}}">
        <Border x:Name="AiSelectionDialog" Padding="18" CornerRadius="12" Background="#EA151E29"
                BorderBrush="#FFD6AD5C" BorderThickness="1">
            <StackPanel>
                <Grid Height="54">
                    <TextBlock x:Name="AiSelectionTitle" Text="Choose players"
                               Foreground="#FFFFE7B0" FontSize="25" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="AiSelectionBackButton" Style="{StaticResource GameBackArrowButton}"
                            Tag="NavigationBack" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="-10,0,0,0"
                            Click="Back_Click" ToolTip="Back"
                            AutomationProperties.Name="Back to game menu" />
                </Grid>
                <ItemsControl x:Name="SeatItems" ItemsSource="{Binding Game.SeatChoices}"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GameSeatButton}" Width="157" Margin="5,0"
                                    MouseEnter="Seat_MouseEnter" Click="Seat_Click"
                                    AutomationProperties.Name="{Binding AccessibleName}">
                                <StackPanel>
                                    <Image Source="{Binding Portrait}" Width="129" Height="129"
                                           Stretch="Uniform" />
                                    <TextBlock Text="{Binding Label}" Foreground="#FFFFF1D7" FontSize="17"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SeatInstructions"
                           Text="Choose at least two. Click a face to cycle: Player → Computer → Unselected."
                           Foreground="#FFE6D9C3" FontSize="14" HorizontalAlignment="Center"
                           Margin="0,15,0,0" />
                <TextBlock Text="{Binding Game.Message}" Foreground="#FFFFD576" Margin="6,8,0,0"
                           Visibility="{Binding Game.Message, Converter={StaticResource MessageVisibility}}"
                           AutomationProperties.LiveSetting="Polite" />
                <Grid Margin="5,14,5,0">
                    <Button x:Name="PlayButton" Content="SET-UP BOARD" Style="{StaticResource GamePlayButton}"
                            HorizontalAlignment="Center" Width="250" Height="56" FontSize="24"
                            FontWeight="Bold" IsEnabled="{Binding Game.CanPlay}"
                            Click="Play_Click" />
                </Grid>
            </StackPanel>
        </Border>
        </Viewbox>

        <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                 VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                 Visibility="{Binding Game.IsCameraSetup, Converter={StaticResource BoolToVisibility}}">
            <Border x:Name="CameraSetupDialog" Width="880" Padding="24" CornerRadius="12"
                    Background="#EA151E29" BorderBrush="#FFD6AD5C" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Game.CameraSetupTitle}" Foreground="#FFFFE7B0" FontSize="30"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CameraSetupHelp"
                               Text="{Binding Game.CameraSetupHelp}"
                               Foreground="#FFF8EEDC" FontSize="19" TextAlignment="Center"
                               Margin="0,12,0,6" />
                    <TextBlock x:Name="CameraSetupMarkerInstruction"
                               Text="Place scoring markers on or near the 1"
                               Foreground="#FFF8EEDC" FontSize="16" TextAlignment="Center"
                               Margin="0,0,0,8"
                               Visibility="{Binding Game.ShowSetupMarkerInstruction, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="Webcam" Foreground="#FFF8EEDC" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox x:Name="CameraSetupDevicePicker" Width="470" Height="38"
                                  Style="{StaticResource GameCameraPicker}"
                                  ItemsSource="{Binding Camera.Devices}"
                                  SelectedItem="{Binding Camera.SelectedDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" SelectionChanged="CameraSetupDevicePicker_SelectionChanged"
                                  AutomationProperties.Name="Board webcam" />
                        <Button Content="Refresh" Style="{StaticResource GameSetupActionButton}"
                                Width="105" Height="38" Padding="4" FontSize="15" Margin="10,0,0,0"
                                Click="RetryCamera_Click" AutomationProperties.Name="Refresh webcams" />
                    </StackPanel>
                    <TextBlock x:Name="CameraSetupCompatibilityMessage"
                               Text="{Binding Camera.CameraCompatibilityMessage}"
                               Foreground="#FFFFD576" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               Width="800" Margin="0,0,0,10"
                               Visibility="{Binding Camera.HasCameraCompatibilityMessage, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Border x:Name="CameraSetupPreviewFrame" Width="800" Height="440" CornerRadius="8"
                            Background="#0E141B" BorderBrush="#99DFB75C" BorderThickness="2"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="CameraSetupPreview" Source="{Binding Camera.Preview}"
                                   Stretch="Uniform" IsHitTestVisible="False"
                                   AutomationProperties.Name="Live board camera preview" />
                            <Canvas x:Name="CameraSetupCornerOverlay" IsHitTestVisible="False"
                                    SizeChanged="CameraSetupCornerOverlay_SizeChanged" />
                            <Border x:Name="CameraSetupNotice" Background="#C9161E28" CornerRadius="5" Padding="10,6"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12"
                                    Visibility="{Binding Camera.ShowGameBoardNotice, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Camera.GameBoardFramingStatus}" Foreground="White"
                                           FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="740"
                                           AutomationProperties.LiveSetting="Polite" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="660"
                                        Visibility="{Binding Camera.IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="{Binding Game.CameraSetupNoCameraStatus}" Foreground="#FFF8EEDC" FontSize="19"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <TextBlock Text="{Binding Camera.Problem}" Foreground="#FFFFD576" FontSize="15"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                           Visibility="{Binding Camera.Problem, Converter={StaticResource MessageVisibility}}" />
                                <Button Content="Retry camera" Style="{StaticResource GameSetupActionButton}"
                                        HorizontalAlignment="Center" Width="180" Height="48" FontSize="16"
                                        Margin="0,18,0,0" Click="RetryCamera_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="ConfirmationCancelButton" Content="CANCEL"
                                Style="{StaticResource GameSetupActionButton}" Width="180" Height="56"
                                FontSize="20" Margin="0,0,16,0" Click="CancelCameraSetup_Click" />
                        <Button x:Name="ConfirmationPlayButton" Content="{Binding Game.CameraSetupActionLabel}"
                                Style="{StaticResource GameSetupActionButton}" Width="235" Height="56"
                                FontSize="22" FontWeight="Bold" IsEnabled="{Binding Game.CanContinueCameraSetup}"
                                Click="CameraSetupPlay_Click" />
                    </StackPanel>
                    <TextBlock Text="{Binding Game.Message}" Foreground="#FFFFD576"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Game.Message, Converter={StaticResource MessageVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Content="Restore earlier completed save (discard newer actions)"
                            Command="{Binding RestoreEarlierCompletedSaveCommand}"
                            IsEnabled="{Binding CanResumeMatch}" Style="{StaticResource GameSetupActionButton}"
                            HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="15" Padding="12,8"
                            Visibility="{Binding HasEarlierCompletedSave, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Viewbox>

        <!-- Gameplay and utility screens share the same MainViewModel and camera stream. -->
        <Grid Background="{StaticResource Surface.Window}"
              Visibility="{Binding Game.IsPlaying, Converter={StaticResource BoolToVisibility}}">
            <views:GameTableView Visibility="{Binding GameplayScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Table}" />
            <views:RebuildView Visibility="{Binding GameplayScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Rebuild}" />
            <views:FinalStandingsView BoardImage="{Binding Camera.GameTablePreview}"
                Visibility="{Binding GameplayScreen, Converter={StaticResource ScreenVisibility}, ConverterParameter=FinalScore}" />

            <Button Content="Phone QR" Command="{Binding OpenMultiHumanPhoneSetupCommand}"
                    Style="{StaticResource PhoneShortcutButton}" Padding="14,8" FontSize="13"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                    AutomationProperties.Name="Show shared phone setup" />

            <Grid Background="#B9000912" Visibility="{Binding ShowMultiHumanPhoneSetup, Converter={StaticResource BoolToVisibility}}">
                <Viewbox Stretch="Uniform" Margin="16">
                    <Border x:Name="MultiHumanPhoneSetupPanel" Width="740" Padding="22" CornerRadius="12"
                            Background="#F51A2531" BorderBrush="#FFD4AC6B" BorderThickness="2">
                        <StackPanel>
                            <TextBlock Text="Set up the shared phone" Foreground="#FFFFE7B0"
                                       FontSize="29" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="For games with more than one human, install the app on one phone and pass it to the active player. Keep the phone and laptop on the same trusted network."
                                       Foreground="#FFF8EEDC" FontSize="15" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="10,8,10,17" />

                            <TextBlock Text="Choose a Private network, then start phone hosting to display its QR code."
                                       Foreground="#FFFFE7B0" FontSize="14" Margin="0,0,0,7" />
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <ComboBox Width="330" Height="38" ItemsSource="{Binding Connection.Interfaces}"
                                          SelectedItem="{Binding Connection.SelectedInterface}"
                                          AutomationProperties.Name="Private network connection">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Refresh networks" Command="{Binding Connection.RefreshCommand}"
                                        Style="{StaticResource GameChoiceButton}" Padding="10,6" Margin="9,0,0,0" />
                                <Button Content="Start hosting" Command="{Binding Connection.StartCommand}"
                                        Style="{StaticResource GameChoiceButton}" Padding="10,6" Margin="9,0,0,0" />
                                <Button Content="Stop" Command="{Binding Connection.StopCommand}"
                                        Style="{StaticResource GameChoiceButton}" Padding="10,6" Margin="9,0,0,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding Connection.Problem}" Foreground="#FFFFD576"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding Connection.Problem, Converter={StaticResource MessageVisibility}}" />

                            <Grid Height="265">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="250" Height="250" Background="#FFFAFAF6" CornerRadius="5"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Padding="7">
                                    <Grid>
                                        <Image Source="{Binding Connection.ConnectionQr}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Visibility="{Binding Connection.ConnectionQr, Converter={StaticResource NullToVisibility}}"
                                               AutomationProperties.Name="Shared phone installation QR code" />
                                        <TextBlock Text="The QR code appears here after hosting starts."
                                                   Foreground="#FF25313C" FontSize="16" TextWrapping="Wrap"
                                                   TextAlignment="Center" VerticalAlignment="Center" Margin="18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Connection.ConnectionQr}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Connection.IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Connection.Status}" Foreground="#FFF8EEDC"
                                               FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="The QR contains only the laptop's local address. Scan it, then choose Add to Home Screen on the phone."
                                               Foreground="#FFE6D9C3" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,8" />
                                    <TextBox Text="{Binding Connection.Address, Mode=OneWay}" IsReadOnly="True"
                                             FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Secure phone address"
                                             Visibility="{Binding Connection.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="Pairing code (enter it on the phone)" Foreground="#FFFFE7B0"
                                               FontSize="13" Margin="0,12,0,3"
                                               Visibility="{Binding Connection.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Connection.PairingCode}" Foreground="#FFFFD576"
                                               FontSize="23" FontWeight="Bold"
                                               Visibility="{Binding Connection.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="The phone card and handoff flow will be completed in a later update."
                                               Foreground="#FFE6D9C3" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Check the certificate fingerprint on the phone against this laptop before trusting it:"
                                       Foreground="#FFE6D9C3" FontSize="11" Margin="0,4,0,2"
                                       Visibility="{Binding Connection.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Connection.Fingerprint}" Foreground="#FFFFE7B0"
                                       FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding Connection.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                            <DockPanel LastChildFill="True" Margin="0,8,0,0">
                                <Button Content="Approve matching phone" Command="{Binding Connection.ApproveCommand}"
                                        Style="{StaticResource GameChoiceButton}" Padding="9,6" DockPanel.Dock="Right" />
                                <TextBlock Text="{Binding Connection.PendingIdentity}" Foreground="#FFF8EEDC"
                                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </DockPanel>

                            <Button Content="CONTINUE TO GAME TABLE" Command="{Binding DismissMultiHumanPhoneSetupCommand}"
                                    Style="{StaticResource GameChoiceButton}" Padding="22,10" FontSize="16"
                                    HorizontalAlignment="Right" Margin="0,14,0,0"
                                    AutomationProperties.Name="Continue to game table" />
                        </StackPanel>
                    </Border>
                </Viewbox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
