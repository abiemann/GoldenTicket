<UserControl x:Class="GoldenTicket.Desktop.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop"
             xmlns:vm="clr-namespace:GoldenTicket.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             mc:Ignorable="d">

    <!--
        The public table screen (DESIGN 4.1). Everything here comes from the public projection: seat
        counts, the face-up market, scores, claimed routes and a redacted history. No hidden hand is
        bound into this tree at any opacity.
    -->

    <UserControl.Resources>
        <local:PlayerColorBrushConverter x:Key="PlayerColorBrush" />
        <local:CardKindBrushConverter x:Key="CardKindBrush" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="420" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Active seat and current instruction -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,8,0"
                            BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                            Background="{Binding Table.ActiveSeatColor, Converter={StaticResource PlayerColorBrush}}" />
                    <TextBlock FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="{Binding Table.ActiveSeatSymbol}" Margin="0,0,6,0" />
                    <TextBlock FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource Action.Primary}" Text="{Binding Table.ActiveSeatName}" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Caption}"
                               Text="{Binding Table.TurnText}" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Caption}"
                               Text="{Binding Table.PhaseText}" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0" FontSize="15" Text="{Binding Table.Instruction}" />

                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{Binding Table.SupplyText}" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Table.VerificationText}" />

                <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource Action.Primary}"
                           Text="{Binding Table.FinalRoundText}"
                           Visibility="{Binding Table.FinalRoundText, Converter={StaticResource EmptyStringToVisibility}}" />

                <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource Action.Primary}"
                           Text="{Binding Table.RulesDecisionText}"
                           Visibility="{Binding Table.RulesDecisionText, Converter={StaticResource EmptyStringToVisibility}}" />

                <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource Action.Primary}"
                           Text="{Binding Status}"
                           Visibility="{Binding Status, Converter={StaticResource EmptyStringToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Left: placement instruction, board, history -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>

                <Border Style="{StaticResource Panel}"
                        Visibility="{Binding NeedsBoardReconciliation, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Check the saved board before resuming" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="Rebuild every claimed route listed below with the correct colour, lane and train count. All other lanes must be empty. Remove any uncommitted placement for now; a pending claim will be offered again after this check. Cards, tickets and turn progress remain saved." />
                        <CheckBox Margin="0,10,0,8" IsChecked="{Binding BoardReconciliationAcknowledged}">
                            <TextBlock TextWrapping="Wrap" Text="I have checked the whole board against the saved route list, including empty lanes. Continue using manual verification." />
                        </CheckBox>
                        <Button Style="{StaticResource PrimaryButton}" Content="Resume after board check"
                                HorizontalAlignment="Left" IsEnabled="{Binding BoardReconciliationAcknowledged}"
                                Command="{Binding ConfirmBoardReconciledCommand}" />
                    </StackPanel>
                </Border>

                <!-- DESIGN 4.5: the acting seat, its colour and symbol, both endpoints, the lane and the count. -->
                <Border Style="{StaticResource Panel}"
                        Visibility="{Binding Table.Placement, Converter={StaticResource NullToVisibility}}">
                    <StackPanel DataContext="{Binding Table.Placement}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0"
                                    BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                    Background="{Binding Color, Converter={StaticResource PlayerColorBrush}}" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Text="{Binding Symbol}" Margin="0,0,8,0" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Text="{Binding Headline}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0" Text="{Binding Detail}" />
                    </StackPanel>
                </Border>

                <CheckBox Margin="0,0,0,8" IsChecked="{Binding Table.WholeBoardAcknowledged}"
                          Visibility="{Binding Table.Placement, Converter={StaticResource NullToVisibility}}">
                    <TextBlock TextWrapping="Wrap" Text="I checked the pending route and every other route against the claimed-route list below, including all empty lanes. The whole board matches the instruction." />
                </CheckBox>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                            Visibility="{Binding Table.Placement, Converter={StaticResource NullToVisibility}}">
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="The whole board matches - confirm"
                            IsEnabled="{Binding Table.WholeBoardAcknowledged}"
                            Command="{Binding ConfirmPlacementCommand}"
                            Visibility="{Binding Table.Placement.AwaitingRestore, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel this claim"
                            Command="{Binding CancelClaimCommand}"
                            Visibility="{Binding Table.Placement.AwaitingRestore, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="The whole before-state matches - confirm"
                            IsEnabled="{Binding Table.WholeBoardAcknowledged}"
                            Command="{Binding ConfirmRestoredCommand}"
                            Visibility="{Binding Table.Placement.AwaitingRestore, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Face-up train cards" />
                        <ItemsControl ItemsSource="{Binding Table.Market}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="96" Height="56" Margin="0,0,8,8" CornerRadius="4"
                                            BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                            Background="{Binding Kind, Converter={StaticResource CardKindBrush}}">
                                        <Border Background="#CCFBF6EA" VerticalAlignment="Bottom" Padding="4,2">
                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Claimed routes" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="The board is the physical one on your table. This is the authoritative record of what has been claimed on it." />
                        <ItemsControl ItemsSource="{Binding Table.ClaimedRoutes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                                Background="{Binding OwnerColor, Converter={StaticResource PlayerColorBrush}}" />
                                        <TextBlock Text="{Binding Symbol}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding OwnerName}" Width="110" />
                                        <TextBlock Text="{Binding RouteText}" Width="300" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Length, StringFormat={}{0} trains}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="What has happened" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="Public events only. A blind draw shows that a card was taken, never which one." />
                        <ItemsControl ItemsSource="{Binding Table.History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Right: scores and the pass-and-hide control -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Your turn" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="{Binding RevealPrompt}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Reveal my private view"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanRevealPrivateSeat}"
                                Command="{Binding RevealPrivateSeatCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Scores" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="Route points only. Destination tickets and the longest continuous route are settled at the end." />

                        <ItemsControl ItemsSource="{Binding Table.Seats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="3"
                                            BorderThickness="1" BorderBrush="{StaticResource Ornament}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                                        Background="{Binding Color, Converter={StaticResource PlayerColorBrush}}" />
                                                <TextBlock Text="{Binding Symbol}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Caption}" Margin="6,2,0,0"
                                                           Text="{Binding Operator}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding Score, Mode=OneWay}" /><Run Text=" route points · " /><Run
                                                    Text="{Binding TrainsRemaining, Mode=OneWay}" /><Run Text=" trains left" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding CardCount, Mode=OneWay}" /><Run Text=" cards · " /><Run
                                                    Text="{Binding TicketCount, Mode=OneWay}" /><Run Text=" tickets · " /><Run
                                                    Text="{Binding RoutesClaimed, Mode=OneWay}" /><Run Text=" routes" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
