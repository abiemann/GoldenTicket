<UserControl x:Class="GoldenTicket.Desktop.Views.CheckpointPhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="1100">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Display}" Text="Reference photo" />
                    <TextBlock Style="{StaticResource Heading}" Text="{Binding CheckpointName}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding ReferenceExplanation}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="This optional photo stays encrypted on this laptop under your Windows account. It contains the board camera image only. Your saved cards, turns, scores, and route ownership remain in the digital checkpoint." />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Before capture, keep the complete board in view, clear hands and private cards from the image, and check that every train matches the committed route list. Remove any uncommitted placement from this reference. This version does not recognize or verify the trains in the photo." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox IsChecked="{Binding OperatorAcknowledged}" IsEnabled="{Binding HasCheckpoint}"
                              Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap"
                                   Text="I checked the whole board against the saved route list. The camera shows the complete board with no private cards, hands, or uncommitted trains." />
                    </CheckBox>
                    <WrapPanel>
                        <Button Content="Capture reference photo" Command="{Binding CaptureReferenceCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="20,10" Margin="0,0,8,8"
                                AutomationProperties.Name="Capture reference photo for this saved checkpoint" />
                        <Button Content="Reload reference" Command="{Binding ReloadReferenceCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="20,10" Margin="0,0,8,8"
                                AutomationProperties.Name="Read back the saved reference photo without taking a new photo" />
                    </WrapPanel>
                    <TextBlock Margin="0,12,0,0" Text="{Binding Status}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding CaptureDetails}" />
                    <Border Margin="0,12,0,0" BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                            Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding PhotoImage}" Stretch="Uniform" MaxHeight="700"
                               AutomationProperties.Name="Saved operator-attested board reference" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
