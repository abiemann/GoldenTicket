<UserControl x:Class="GoldenTicket.Desktop.Views.CheckpointPhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="1100">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Display}" Text="Saved board photo" />
                    <TextBlock Style="{StaticResource Heading}" Text="{Binding CheckpointName}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding ReferenceExplanation}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding PhotoStateSummary}" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Border x:Name="SavedPhotoPanel" BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                            Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                        <Image x:Name="SavedBoardPhoto" Source="{Binding PhotoImage}" Stretch="Uniform" MaxHeight="700"
                               AutomationProperties.Name="Saved operator-attested board reference" />
                    </Border>
                    <StackPanel x:Name="MissingPhotoPanel" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="This checkpoint needs a saved board image. Capture and verify it before clearing the board or resuming. Escape → Save Game captures the image as part of saving."
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding CaptureGuidance}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Camera setup" Command="{Binding CameraSetupCommand}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,12"
                                Visibility="{Binding CameraSetupCommand, Converter={StaticResource NullToVisibility}}" />
                        <StackPanel x:Name="LivePreviewPanel" Visibility="{Binding HasLivePreview, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,12">
                            <TextBlock Text="Live board crop (not saved)" Style="{StaticResource Heading}" />
                            <Image x:Name="LiveBoardPreview" Source="{Binding Camera.BoardPreview}" Stretch="Uniform" Height="280"
                                   AutomationProperties.Name="Live cropped camera preview, not a saved photo" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding OperatorAcknowledged}" IsEnabled="{Binding HasCheckpoint}"
                                  Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding BoardConfirmationText}" />
                        </CheckBox>
                        <Button Content="Capture reference photo" Command="{Binding CaptureReferenceCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="20,10" Margin="0,0,8,8"
                                AutomationProperties.Name="Capture reference photo for this saved checkpoint" />
                    </StackPanel>
                    <Button Content="Reload reference" Command="{Binding ReloadReferenceCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="20,10" Margin="0,0,8,8"
                            AutomationProperties.Name="Read back the saved reference photo without taking a new photo" />
                    <TextBlock Margin="0,12,0,0" Text="{Binding Status}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="{Binding CaptureDetails}" />
                    <Expander Header="About board reference photos" Margin="0,12,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" Text="This required image is saved on this laptop with its digital checkpoint. Cards, turns, scores, and route ownership remain in the digital checkpoint." />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Before capture, check every committed route against the saved route list. Keep any trains already placed for the unfinished route in their exact spaces. Remove hands and private cards from the image. The camera checks the train positions and colors before saving unfinished placement progress." />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
