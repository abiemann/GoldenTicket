<UserControl x:Class="GoldenTicket.Desktop.Views.ConnectionModePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ModeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFE7B0" />
            <Setter Property="Background" Value="#FF192733" />
            <Setter Property="BorderBrush" Value="#FF89744B" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="15,12" MinHeight="105">
                            <Grid>
                                <ContentPresenter Margin="0,0,20,0" VerticalAlignment="Center" />
                                <Ellipse x:Name="SelectedDot" Width="11" Height="11" Stroke="#FFD4AC6B" StrokeThickness="1.5"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFD576" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="3" />
                                <Setter TargetName="Frame" Property="Padding" Value="13.5,10.5" />
                                <Setter TargetName="Frame" Property="Background" Value="#FF3C3025" />
                                <Setter TargetName="SelectedDot" Property="Fill" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFF0CC" />
                                <Setter TargetName="Frame" Property="Background" Value="#FF4A3E2D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid IsEnabled="{Binding CanChooseMode}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <RadioButton x:Name="QuickPlayModeOption" IsChecked="{Binding UseQuickPlay}" Style="{StaticResource ModeChoice}"
                         Margin="0,0,10,0" AutomationProperties.Name="Quick play, recommended">
                <StackPanel>
                    <TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#FFFFD576" />
                    <TextBlock Text="Quick play" FontSize="21" FontWeight="Bold" Margin="0,3,0,4" />
                    <TextBlock Text="Scan QR → join → play" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Text="No installation. No certificate." FontSize="12" Foreground="#FFE6D9C3" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PracticalModeOption" Grid.Column="1" IsChecked="{Binding UsePractical}" Style="{StaticResource ModeChoice}"
                         AutomationProperties.Name="Practical, no phone">
                <StackPanel>
                    <TextBlock Text="NO PHONE NEEDED" FontSize="10" Foreground="#FFE6D9C3" />
                    <TextBlock Text="PRACTICAL" FontSize="19" FontWeight="Bold" Margin="0,3,0,4" />
                    <TextBlock Text="Share the laptop" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Text="We'll look away when it's not our turn." FontSize="12" Foreground="#FFE6D9C3" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </Grid>
    </StackPanel>
</UserControl>
