<UserControl x:Class="GoldenTicket.Desktop.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop"
             xmlns:vm="clr-namespace:GoldenTicket.Desktop.ViewModels"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:PlayerColorBrushConverter x:Key="PlayerColorBrush" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource Display}" Text="GoldenTicket" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4"
                       Text="A companion for a physical game of Ticket to Ride. The board and trains stay on the table; cards, decks and destination tickets are digital." />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Setup.EditionSummary}" Margin="0,0,0,16" />

            <!-- DESIGN 6.3: say plainly whether the board data has been checked. -->
            <Border Style="{StaticResource Panel}"
                    Visibility="{Binding Setup.DataIsAudited, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Board data is not audited yet" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Setup.DataAuditWarning}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Seats" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="Set each seat's name, physical train colour and operator. Play proceeds down this list and wraps around, which is the clockwise order at your table." />

                    <ItemsControl ItemsSource="{Binding Setup.Seats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                            BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                            Background="{Binding Color, Converter={StaticResource PlayerColorBrush}}" />

                                    <TextBox Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                    <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableColors}"
                                              SelectedItem="{Binding Color}" />

                                    <CheckBox Grid.Column="3" Content="Computer" IsChecked="{Binding IsComputer}" />

                                    <ComboBox Grid.Column="4" ItemsSource="{Binding AvailableDifficulties}"
                                              SelectedItem="{Binding Difficulty}" Width="140" HorizontalAlignment="Left"
                                              IsEnabled="{Binding IsComputer}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Add seat" Click="OnAddSeat" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Remove seat" Click="OnRemoveSeat" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Starting player" />
                    <ComboBox ItemsSource="{Binding Setup.Seats}" Width="240" HorizontalAlignment="Left"
                              DisplayMemberPath="DisplayName"
                              SelectedIndex="{Binding Setup.StartingSeatIndex}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Before you start" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Leave the physical train cards and destination tickets in the box: this application deals and holds every card, for every seat. Put the board and the plastic trains on the table as usual." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="This build verifies physical placement by asking the operator to confirm it. Camera verification, the phone companion, and story mode belong to later milestones and are not present." />
                    <CheckBox Margin="0,10,0,0" IsChecked="{Binding Setup.ManualVerificationAccepted}"
                              Content="Use manual verification: I will check all claimed routes and empty lanes at each confirmation." />
                </StackPanel>
            </Border>

            <TextBlock Foreground="{StaticResource Action.Primary}" FontWeight="SemiBold" Margin="0,0,0,8"
                       Text="{Binding Setup.ValidationMessage}"
                       Visibility="{Binding Setup.ValidationMessage, Converter={StaticResource EmptyStringToVisibility}}" />

            <StackPanel Orientation="Horizontal" Margin="0,4,0,20">
                <Button Style="{StaticResource PrimaryButton}" Content="Start the match"
                        Command="{Binding StartMatchCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Refresh saved matches"
                        Command="{Binding LoadSavedSessionsCommand}" />
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}" Text="Saved matches" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Text="A saved match is restored by replaying its journal and checking the result against the stored fingerprint. Private hands stay covered until a seat reveals them." />

                    <ListBox ItemsSource="{Binding Setup.SavedSessions}" MaxHeight="160"
                             SelectedItem="{Binding Setup.SelectedSavedSession}"
                             DisplayMemberPath="Description" />

                    <Button Style="{StaticResource SecondaryButton}" Content="Resume selected match"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="{Binding ResumeMatchCommand}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
