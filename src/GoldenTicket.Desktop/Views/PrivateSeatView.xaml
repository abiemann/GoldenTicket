<UserControl x:Class="GoldenTicket.Desktop.Views.PrivateSeatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop"
             xmlns:vm="clr-namespace:GoldenTicket.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             mc:Ignorable="d" KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">

    <!--
        The private seat view (DESIGN 4.2-4.3). It sits on an opaque curtain, and hiding it discards
        the view model rather than making it transparent.
    -->

    <UserControl.Resources>
        <local:CardKindBrushConverter x:Key="CardKindBrush" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        <Style x:Key="SoloDestinationCard" TargetType="Button">
            <Setter Property="Background" Value="#FFF4E5C8" />
            <Setter Property="BorderBrush" Value="#FFC3934B" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardFrame" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardFrame" Property="BorderBrush" Value="#FFFFD576" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoloOverlayAction" TargetType="Button">
            <Setter Property="Background" Value="#FF1A2531" />
            <Setter Property="BorderBrush" Value="#FFD6AD5C" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="#FFFFE7B0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#FF53372D" />
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
      <Grid Background="{StaticResource Surface.Curtain}"
            Visibility="{Binding ShowSoloOpeningTicketsOnBoard, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
        <Border Background="{StaticResource Surface.Window}" CornerRadius="6" Margin="28"
                BorderBrush="{StaticResource Ornament}" BorderThickness="2">
            <DockPanel Margin="20" DataContext="{Binding PrivateSeat}">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock FontSize="20" Text="{Binding Symbol}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center"
                               Visibility="{Binding DataContext.IsSingleHumanGame, RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <Run Text="{Binding SeatName, Mode=OneWay}" /><Run Text=" - private view" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center" Text="Your cards"
                               Visibility="{Binding DataContext.IsSingleHumanGame, RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource BoolToVisibility}}" />
                    <Button
                            Margin="24,0,0,0"
                            Command="{Binding DataContext.HidePrivateSeatCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Content" Value="Hide (pass the laptop on)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSingleHumanGame, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Content" Value="Back to table" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontWeight="SemiBold"
                           Foreground="{StaticResource Action.Primary}" Text="{Binding Message}"
                           Visibility="{Binding Message, Converter={StaticResource EmptyStringToVisibility}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Hand and tickets -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Your train cards" />
                                    <ItemsControl ItemsSource="{Binding Hand}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <Border Width="28" Height="18" CornerRadius="3" Margin="0,0,8,0"
                                                            BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                                            Background="{Binding Kind, Converter={StaticResource CardKindBrush}}" />
                                                    <TextBlock Text="{Binding Kind}" Width="110" />
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Your destinations" />
                                    <ItemsControl ItemsSource="{Binding Tickets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Width="18" Text="✓" FontWeight="Bold"
                                                               Foreground="{StaticResource Status.Success}"
                                                               Visibility="{Binding Completed, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Width="18" Text="·"
                                                               Visibility="{Binding Completed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                    <TextBlock Text="{Binding Description}" Width="200" />
                                                    <TextBlock Text="{Binding Points}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1">

                            <!-- Destination ticket offer -->
                            <Border Style="{StaticResource Panel}"
                                    Visibility="{Binding MustChooseTickets, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Choose which destinations to keep" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                               Text="{Binding TicketInstruction}" />

                                    <ItemsControl ItemsSource="{Binding Offer}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Keep}" Margin="0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Description}" Width="240" />
                                                        <TextBlock Text="{Binding Points}" Width="40" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Estimate}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                                            HorizontalAlignment="Left" Content="Keep the ticked destinations"
                                            Command="{Binding DataContext.CommitTicketsCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </Border>

                            <!-- Train card draw -->
                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding MustChooseTickets, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Take train cards" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                               Text="A face-up locomotive takes your whole turn, and cannot be your second card."
                                               Visibility="{Binding IsSecondDraw, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                               Text="Second card. Face-up locomotives are not available for this pick."
                                               Visibility="{Binding IsSecondDraw, Converter={StaticResource BoolToVisibility}}" />

                                    <ItemsControl ItemsSource="{Binding DrawableSlots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,8,8" Padding="0" BorderThickness="0"
                                                        Background="Transparent" Cursor="Hand"
                                                        Command="{Binding DataContext.DrawFaceUpCardCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Width="92" Height="54" CornerRadius="4"
                                                            BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                                            Background="{Binding Kind, Converter={StaticResource CardKindBrush}}">
                                                        <Border Background="#CCFBF6EA" VerticalAlignment="Bottom" Padding="4,2">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Draw blind from the deck"
                                                IsEnabled="{Binding CanDrawBlind}"
                                                Command="{Binding DataContext.DrawBlindCardCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="Draw destinations"
                                                IsEnabled="{Binding CanDrawTickets}"
                                                Command="{Binding DataContext.DrawTicketsCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Route claim -->
                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding CanClaim, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Claim a route" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                               Text="Choose the route, then choose how to pay for it. Nothing is spent until the trains are on the board and the placement is confirmed." />

                                    <ListBox ItemsSource="{Binding ClaimOptions}" SelectedItem="{Binding SelectedClaim}"
                                             MaxHeight="220" Margin="0,0,0,8">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RouteText}" Width="280" />
                                                    <TextBlock Text="{Binding Length, StringFormat={}{0} trains}" Width="80" />
                                                    <TextBlock Text="{Binding Points, StringFormat={}{0} pts}" Width="60" />
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ColorRequirement}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Payment" FontWeight="SemiBold" />
                                    <ListBox ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}"
                                             MaxHeight="120" DisplayMemberPath="Description" Margin="0,4,0,8" />

                                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                            Content="Reserve this route and place the trains"
                                            Command="{Binding DataContext.PlanClaimCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
      </Grid>

      <!-- Use the table's 1440x900 scene coordinates so the live board remains visible above these private cards. -->
      <Grid x:Name="SoloOpeningOverlay" Background="Transparent"
            Visibility="{Binding ShowSoloOpeningTicketsOnBoard, Converter={StaticResource BoolToVisibility}}">
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Margin="8">
          <Canvas Width="1440" Height="900" ClipToBounds="True">
            <Border x:Name="SoloCardsTile" Canvas.Left="270" Canvas.Top="690" Width="900" Height="205"
                    Padding="12,8" CornerRadius="10" Background="#F01A2531"
                    BorderBrush="#FFD6AD5C" BorderThickness="2">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Your Cards" Foreground="#FFFFE7B0" FontSize="19"
                           FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1"
                           Text="Keep all three, or click one destination to drop it. You must keep at least two."
                           Foreground="#FFF8EEDC" FontSize="12" TextAlignment="Center"
                           Margin="0,0,0,3" />
                <ItemsControl x:Name="SoloDestinationCards" Grid.Row="2"
                              ItemsSource="{Binding PrivateSeat.Offer}" HorizontalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource SoloDestinationCard}" Width="270" Height="99"
                              Margin="5,0" Click="SoloDestination_Click"
                              AutomationProperties.Name="{Binding Description}">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Text="DESTINATION" Foreground="#FF684329" FontSize="10"
                                     FontWeight="Bold" HorizontalAlignment="Center" />
                          <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Description}" Foreground="#FF33271F" FontSize="17"
                                       FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Points, StringFormat={}{0} points}" Foreground="#FF8C552C"
                                       FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                          </StackPanel>
                          <TextBlock Grid.Row="2" Text="Click to drop" Foreground="#FF684329"
                                     FontSize="10" HorizontalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="3" Margin="0,3,0,0">
                  <TextBlock Text="{Binding PrivateSeat.Message}" Foreground="#FFFFD576"
                             FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                             MaxWidth="440" HorizontalAlignment="Left"
                             Visibility="{Binding PrivateSeat.Message, Converter={StaticResource EmptyStringToVisibility}}" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SoloKeepAllButton" Content="KEEP ALL THREE" Width="170" Height="35"
                            Style="{StaticResource SoloOverlayAction}" Click="SoloKeepAll_Click" />
                  </StackPanel>
                </Grid>
                <Grid x:Name="SoloDropConfirmation" Grid.RowSpan="4"
                      Visibility="Collapsed" Background="#F0151E29">
                  <Border Width="465" Padding="12" CornerRadius="10" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Background="#FF1A2531"
                          BorderBrush="#FFFFD576" BorderThickness="2">
                    <StackPanel>
                      <TextBlock Text="Drop this destination?" Foreground="#FFFFE7B0" FontSize="19"
                                 FontWeight="Bold" TextAlignment="Center" />
                      <TextBlock x:Name="SoloDropName" Foreground="#FFF8EEDC" FontSize="15"
                                 TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,8" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="NO, GO BACK" Width="150" Height="36"
                                Style="{StaticResource SoloOverlayAction}" Click="SoloDropNo_Click" />
                        <Button Content="YES, DROP IT" Width="150" Height="36" Margin="10,0,0,0"
                                Style="{StaticResource SoloOverlayAction}" Click="SoloDropYes_Click" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>
          </Canvas>
        </Viewbox>
      </Grid>
    </Grid>
</UserControl>
