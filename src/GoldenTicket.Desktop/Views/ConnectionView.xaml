<UserControl x:Class="GoldenTicket.Desktop.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop"
             xmlns:views="clr-namespace:GoldenTicket.Desktop.Views">
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
            <TextBlock Text="How will you play?" Style="{StaticResource Display}" />
            <TextBlock Text="Pass one phone around with Quick play, or choose PRACTICAL to take turns on this laptop."
                       Margin="0,0,0,16" />
            <Border Background="#FF192733" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <views:ConnectionModePicker />
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding UsePractical, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Everyone at the same table" Style="{StaticResource Heading}" />
                    <TextBlock Text="When it's your turn, show your cards on the laptop. Everyone else looks away. Your cards hide before the next player's turn. No phone or network setup needed." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Visibility="{Binding UseQuickPlay, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Action.Primary}" FontWeight="SemiBold" Margin="0,0,0,12" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="1 · Start the local host" Style="{StaticResource Heading}" />
                    <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" MinWidth="460" HorizontalAlignment="Left"
                              IsEnabled="{Binding CanChooseNetwork}"
                              AutomationProperties.Name="Private network connection" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Refresh networks" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Windows network settings" Command="{Binding OpenNetworkSettingsCommand}" Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="Start phone hosting" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Stop hosting" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{Binding ConnectionHeading}" Style="{StaticResource Heading}" />
                    <Image Grid.Row="1" Source="{Binding ConnectionQr}" Width="246" Height="246" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,24,0"
                           VerticalAlignment="Top" Visibility="{Binding ConnectionQr, Converter={StaticResource NullToVisibility}}"
                           AutomationProperties.Name="Connection QR code containing only the local address" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="{Binding ScanInstruction}" />
                        <TextBox Text="{Binding Address, Mode=OneWay}" IsReadOnly="True" Margin="0,12,0,6" AutomationProperties.Name="Phone game address" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Copy app address" Command="{Binding CopyAddressCommand}" Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Join the game" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding PairInstruction}" />
                    <TextBlock Text="{Binding PairingCode}" FontSize="30" FontWeight="Bold" Margin="0,10,0,10" />
                    <Button Content="New pairing code" Command="{Binding NewCodeCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding PendingIdentity}" Margin="0,14,0,10" FontWeight="SemiBold" />
                    <WrapPanel>
                        <Button Content="Approve matching phone" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Disconnect controller" Command="{Binding RevokeCommand}" Style="{StaticResource SecondaryButton}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Controller}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <Expander Header="Connection troubleshooting" Margin="0,8,0,20">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="If the phone cannot connect, check Windows marks this trusted LAN Private and both devices use the same router without guest isolation. If needed, run this narrowly scoped rule in PowerShell as Administrator. No router port forwarding is required." />
                    <TextBox Text="{Binding FirewallCommand, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True" Margin="0,12,0,12" />
                    <Button Content="Copy scoped firewall command" Command="{Binding CopyFirewallCommandCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
