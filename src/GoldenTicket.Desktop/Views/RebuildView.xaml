<UserControl x:Class="GoldenTicket.Desktop.Views.RebuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GoldenTicket.Desktop"
             xmlns:vm="clr-namespace:GoldenTicket.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             mc:Ignorable="d">

    <!--
        Guided reconstruction (DESIGN 19.8). The canonical target diagram lists routes by seat,
        colour, endpoint cities, lane and train count, with remaining-stock guidance beside it.
        Private hands and tickets stay covered throughout: nothing here comes from a seat view.
    -->

    <UserControl.Resources>
        <local:PlayerColorBrushConverter x:Key="PlayerColorBrush" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        <local:TrainCountTextConverter x:Key="TrainCountText" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="460" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Display}" Text="Rebuild the board" />
                <TextBlock FontSize="15" Text="{Binding Table.RebuildHeadline}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                           Text="Put the trains back in any order. Nothing is scored and no cards move while you rebuild." />
                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{StaticResource Action.Primary}"
                           Text="{Binding Table.RebuildSuspendedAction}"
                           Visibility="{Binding Table.RebuildSuspendedAction,
                                       Converter={StaticResource EmptyStringToVisibility}}" />
                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{StaticResource Action.Primary}"
                           Text="{Binding Status}"
                           Visibility="{Binding Status, Converter={StaticResource EmptyStringToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- The saved position -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="The saved position" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="SavedPhotoPanel" Margin="0,0,0,16"
                                    Visibility="{Binding CheckpointPhoto.HasPhoto, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontWeight="SemiBold" Text="Saved board reference photo" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,8"
                                       Text="Board contents were confirmed by the operator when this photo was saved. Use the saved route list below to rebuild." />
                            <Image x:Name="SavedBoardPhoto" Source="{Binding CheckpointPhoto.PhotoImage}"
                                   Stretch="Uniform" MaxHeight="320"
                                   AutomationProperties.Name="Saved board reference photo for this checkpoint" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="{Binding CheckpointPhoto.CaptureDetails}" />
                        </StackPanel>

                        <Border x:Name="MissingPhotoPanel" Style="{StaticResource Panel}"
                                Visibility="{Binding CheckpointPhoto.HasPhoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding CheckpointPhoto.PhotoStateSummary}" />
                                <Button Content="Add or view board photo" Command="{Binding ShowCheckpointPhotoCommand}"
                                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="Saved routes" />
                        <TextBlock x:Name="EmptySavedPosition" Margin="0,4,0,8"
                                   Text="This saved position has no routes. All route lanes should be empty.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Table.RebuildTarget.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Table.RebuildTarget}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Ornament}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                                    Background="{Binding OwnerColor, Converter={StaticResource PlayerColorBrush}}" />
                                            <TextBlock Text="{Binding Symbol}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding OwnerName}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding RouteText}" Margin="20,4,0,0" />
                                        <WrapPanel Margin="20,4,0,0">
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,12,0"
                                                       Text="{Binding TrainCount, Converter={StaticResource TrainCountText}}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding LaneLabel}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Stock guidance and the confirmation -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Trains each seat should have left" />
                        <ItemsControl ItemsSource="{Binding Table.RebuildStock}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                BorderBrush="{StaticResource Text.Primary}" BorderThickness="1"
                                                Background="{Binding Color, Converter={StaticResource PlayerColorBrush}}" />
                                        <TextBlock Text="{Binding Symbol}" Width="20" />
                                        <TextBlock Text="{Binding SeatName}" Width="120" />
                                        <TextBlock>
                                            <Run Text="{Binding OnBoard, Mode=OneWay}" /><Run Text=" placed, " /><Run
                                                Text="{Binding RemainingOffBoard, Mode=OneWay}" /><Run Text=" in hand" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Confirm and resume" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="You confirm the rebuilt board yourself. Check every route in the list, including lanes of parallel routes. A saved reference photo can help; automatic piece verification is not enabled." />
                        <Button Content="Add or view board photo" Command="{Binding ShowCheckpointPhotoCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,0,12" />

                        <CheckBox Margin="0,0,0,10" IsChecked="{Binding Table.RebuildAcknowledged}"
                                  Content="Every saved route is back on the board, and nothing else is." />

                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                Margin="0,0,0,8" Content="The board matches the saved position"
                                Command="{Binding AttestRebuildCommand}"
                                Visibility="{Binding Table.RebuildAttested,
                                            Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <StackPanel Visibility="{Binding Table.RebuildAttested,
                                                Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold"
                                       Foreground="{StaticResource Status.Success}"
                                       Text="Confirmed by you. Keep the board unchanged and the confirmation checked until you resume." />
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                    Content="Resume game" Command="{Binding ResumePackedGameCommand}"
                                    IsEnabled="{Binding Table.RebuildAcknowledged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
