<Window x:Class="GoldenTicket.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GoldenTicket.Desktop"
        xmlns:views="clr-namespace:GoldenTicket.Desktop.Views"
        xmlns:vm="clr-namespace:GoldenTicket.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        mc:Ignorable="d"
        Title="GoldenTicket" Height="880" Width="1400" MinHeight="620" MinWidth="1000"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Background="{StaticResource Surface.Window}"
        Foreground="{StaticResource Text.Primary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        <local:ScreenVisibilityConverter x:Key="ScreenVisibility" />
        <Style x:Key="ExitMenuButton" TargetType="Button">
            <Setter Property="Background" Value="#DB17212C" />
            <Setter Property="Foreground" Value="#FFFFE7B0" />
            <Setter Property="BorderBrush" Value="#FFD4AC6B" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#EC522D26" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#E14E2F2B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFD576" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExitMenuSaveButton" TargetType="Button" BasedOn="{StaticResource ExitMenuButton}">
            <Setter Property="Background" Value="#EC522D26" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style x:Key="ResumeTurnOkButton" TargetType="Button" BasedOn="{StaticResource ExitMenuSaveButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
      <Grid x:Name="GameContent">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsResumeTurnAnnouncementOpen}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
      <Grid x:Name="TechnicalLayer" IsEnabled="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Surface.Panel}" Padding="16,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPrivateVisible}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="GoldenTicket" FontWeight="Bold" FontSize="22"
                           Foreground="{StaticResource Action.Primary}" VerticalAlignment="Center" Margin="0,0,24,0" />
                <WrapPanel>
                    <Button x:Name="ReturnToGameButton" Content="Return to game" Click="ReturnToGame_Click"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Content="Game table" Command="{Binding ShowGameCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Camera" Command="{Binding ShowCameraCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Connect phone" Command="{Binding ShowConnectionCommand}" Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding CanConnectPhone, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Saved board photo" Command="{Binding ShowCheckpointPhotoCommand}" Style="{StaticResource SecondaryButton}" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPrivateVisible}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        <!-- Public screens. Only one is realised as visible at a time. -->
        <views:SetupView
            Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Setup}" />

        <views:TableView
            Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Table}" />

        <views:RebuildView
            Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Rebuild}" />

        <views:FinalScoreView
            Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=FinalScore}" />
        <Border Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Camera}">
            <views:CameraView DataContext="{Binding Camera}" />
        </Border>
        <Border Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Connection}">
            <views:ConnectionView DataContext="{Binding Connection}" />
        </Border>
        <Border Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=CheckpointPhoto}">
            <views:CheckpointPhotoView DataContext="{Binding CheckpointPhoto}" />
        </Border>
        </Grid>

        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="12,6"
                Background="{StaticResource Surface.Panel}"
                Visibility="{Binding Busy, Converter={StaticResource EmptyStringToVisibility}}">
            <TextBlock Text="{Binding Busy}" FontWeight="SemiBold" />
        </Border>
      </Grid>

      <views:GameScreenView x:Name="GameLayer" />

        <!--
            The privacy curtain (DESIGN 4.7). It is fully opaque and covers everything, and the
            private view under it exists only while a seat is revealed.
        -->
        <views:PrivateSeatView
            Visibility="{Binding IsPrivateVisible, Converter={StaticResource BoolToVisibility}}" />

        <Grid x:Name="GameExitMenuOverlay" Background="#C9000912"
              Visibility="{Binding IsGameExitMenuOpen, Converter={StaticResource BoolToVisibility}}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
              <StackPanel Orientation="Horizontal">
                <Border Width="540" Padding="28" CornerRadius="12"
                        VerticalAlignment="Center"
                        Background="#F51A2531" BorderBrush="#FFD4AC6B" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="Leave the game?" Foreground="#FFFFE7B0"
                                   FontSize="30" FontWeight="Bold" TextAlignment="Center" />
                        <TextBlock Text="Save Game checks the completed routes and any unfinished train placement, takes a fresh board photo, and remembers whose turn it is before returning to the menu. Choosing it confirms that the camera shows only the board."
                                   Foreground="#FFF8EEDC" FontSize="16" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,12,0,8" />
                        <TextBlock Text="Quit to Menu discards changes since the last saved game."
                                   Foreground="#FFE6D9C3" FontSize="14" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding GameExitInventorySummary}"
                                   Foreground="#FFE6D9C3" FontSize="14" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding GameExitStatus}"
                                   Foreground="#FFFFD576" FontSize="14" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,12"
                                   Visibility="{Binding GameExitStatus, Converter={StaticResource EmptyStringToVisibility}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="SaveGameMenuButton" Content="Save Game"
                                Command="{Binding SaveGameToMenuCommand}"
                                Style="{StaticResource ExitMenuSaveButton}" Margin="0,0,0,10"
                                AutomationProperties.Name="Save Game and return to menu" />
                        <Button Content="Quit to Menu"
                                Command="{Binding QuitToMenuCommand}"
                                Style="{StaticResource ExitMenuButton}" Margin="0,0,0,10"
                                AutomationProperties.Name="Quit to Menu without saving" />
                        <Button Content="Return to Game" Click="CloseGameExitMenu_Click"
                                Style="{StaticResource ExitMenuButton}"
                                AutomationProperties.Name="Return to Game" />
                    </StackPanel>
                </Border>
                <Border x:Name="GameExitEvidencePanel" Width="680" Padding="18" Margin="16,0,0,0"
                        VerticalAlignment="Center" CornerRadius="12"
                        Background="#F51A2531" BorderBrush="#FFD4AC6B" BorderThickness="2"
                        Visibility="{Binding GameExitEvidence, Converter={StaticResource NullToVisibility}}">
                    <StackPanel DataContext="{Binding GameExitEvidence}">
                        <TextBlock Text="Check the highlighted areas" Foreground="#FFFFE7B0"
                                   FontSize="24" FontWeight="Bold" Margin="0,0,0,10" />
                        <Viewbox Stretch="Uniform">
                            <Grid Width="960" Height="600" ClipToBounds="True">
                                <Image Source="{Binding Image}" Stretch="Fill"
                                       AutomationProperties.Name="Camera frame used for the failed board check" />
                                <ItemsControl ItemsSource="{Binding Detections}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                                           Stroke="#FFFFD576" StrokeThickness="3" Fill="#30432118" />
                                                <Border Background="#FF17232D" BorderBrush="#FFFFD576"
                                                        BorderThickness="1" CornerRadius="3" Padding="3,0"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Number}" Foreground="#FFFFD576"
                                                               FontSize="16" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                        <TextBlock Text="{Binding Caption}" Foreground="#FFE6D9C3" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,10,0,8" />
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Detections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" Foreground="#FFFFE7B0"
                                                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
              </StackPanel>
            </Viewbox>
        </Grid>
      </Grid>

        <Grid x:Name="ResumeTurnAnnouncementOverlay" Background="#C9000912"
              Visibility="{Binding IsResumeTurnAnnouncementOpen, Converter={StaticResource BoolToVisibility}}"
              FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Border Width="540" Padding="28" CornerRadius="12"
                        Background="#F51A2531" BorderBrush="#FFD4AC6B" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="Ready to continue" Foreground="#FFFFE7B0"
                                   FontSize="30" FontWeight="Bold" TextAlignment="Center" />
                        <TextBlock Text="{Binding ResumeTurnAnnouncementText}"
                                   Foreground="#FFF8EEDC" FontSize="20" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,16,0,24"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="ResumeTurnOkButton" Content="OK" IsDefault="True"
                                Command="{Binding AcknowledgeResumeTurnCommand}"
                                Style="{StaticResource ResumeTurnOkButton}"
                                AutomationProperties.Name="OK, continue the saved turn" />
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
