<Window x:Class="GoldenTicket.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GoldenTicket.Desktop"
        xmlns:views="clr-namespace:GoldenTicket.Desktop.Views"
        xmlns:vm="clr-namespace:GoldenTicket.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        mc:Ignorable="d"
        Title="GoldenTicket" Height="880" Width="1400" MinHeight="620" MinWidth="1000"
        Background="{StaticResource Surface.Window}"
        Foreground="{StaticResource Text.Primary}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
        <local:ScreenVisibilityConverter x:Key="ScreenVisibility" />
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
      <Grid x:Name="TechnicalLayer" IsEnabled="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Surface.Panel}" Padding="16,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPrivateVisible}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="GoldenTicket" FontWeight="Bold" FontSize="22"
                           Foreground="{StaticResource Action.Primary}" VerticalAlignment="Center" Margin="0,0,24,0" />
                <Button DockPanel.Dock="Right" Content="{Binding Camera.ComputeBadge}" ToolTip="{Binding Camera.ComputeExplanation}"
                        Command="{Binding ShowCameraCommand}" Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="Image processor status. Open camera settings." />
                <WrapPanel>
                    <Button x:Name="ReturnToGameButton" Content="Return to game" Click="ReturnToGame_Click"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Content="Game table" Command="{Binding ShowGameCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Camera" Command="{Binding ShowCameraCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Connect phone" Command="{Binding ShowConnectionCommand}" Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding CanConnectPhone, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Saved board photo" Command="{Binding ShowCheckpointPhotoCommand}" Style="{StaticResource SecondaryButton}" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPrivateVisible}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        <!-- Public screens. Only one is realised as visible at a time. -->
        <views:SetupView
            Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Setup}" />

        <views:TableView
            Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Table}" />

        <views:RebuildView
            Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Rebuild}" />

        <views:FinalScoreView
            Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=FinalScore}" />
        <Border Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Camera}">
            <views:CameraView DataContext="{Binding Camera}" />
        </Border>
        <Border Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=Connection}">
            <views:ConnectionView DataContext="{Binding Connection}" />
        </Border>
        <Border Visibility="{Binding Screen, Converter={StaticResource ScreenVisibility}, ConverterParameter=CheckpointPhoto}">
            <views:CheckpointPhotoView DataContext="{Binding CheckpointPhoto}" />
        </Border>
        </Grid>

        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="12,6"
                Background="{StaticResource Surface.Panel}"
                Visibility="{Binding Busy, Converter={StaticResource EmptyStringToVisibility}}">
            <TextBlock Text="{Binding Busy}" FontWeight="SemiBold" />
        </Border>
      </Grid>

      <views:GameScreenView x:Name="GameLayer" />

        <!--
            The privacy curtain (DESIGN 4.7). It is fully opaque and covers everything, and the
            private view under it exists only while a seat is revealed.
        -->
        <views:PrivateSeatView
            Visibility="{Binding IsPrivateVisible, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
