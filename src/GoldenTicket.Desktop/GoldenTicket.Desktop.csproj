<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- DESIGN 17.1: net10.0-windows10.0.26100.0 / win-x64, with a technical compatibility
         floor of 10.0.22000.0 that is not itself a support promise. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>GoldenTicket.Desktop</RootNamespace>
    <AssemblyName>GoldenTicket</AssemblyName>
    <!-- DESIGN 17.1: no trimming, Native AOT, or single-file extraction in the first release. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="$(RepoRoot)assets/artwork/golden-ticket-snowy-twilight-20260914.png"
              Link="Assets/golden-ticket-snowy-twilight.png" />
    <Resource Include="$(RepoRoot)assets/artwork/characters/character-*-256.png"
              Link="Assets/Characters/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoldenTicket.Domain\GoldenTicket.Domain.csproj" />
    <ProjectReference Include="..\GoldenTicket.Application\GoldenTicket.Application.csproj" />
    <ProjectReference Include="..\GoldenTicket.AI\GoldenTicket.AI.csproj" />
    <ProjectReference Include="..\GoldenTicket.Persistence\GoldenTicket.Persistence.csproj" />
    <ProjectReference Include="..\GoldenTicket.CompanionHost\GoldenTicket.CompanionHost.csproj" />
    <ProjectReference Include="..\GoldenTicket.Vision\GoldenTicket.Vision.csproj" />
  </ItemGroup>

  <!-- Reviewed ONNX graphs include their trained weights and are versioned with the app.
       Training photos, checkpoints, environments, and diagnostics stay in ignored artifacts. -->
  <ItemGroup>
    <Content Include="$(RepoRoot)assets/models/pieces/piece-detector.onnx" Link="models/pieces/piece-detector.onnx"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)assets/models/pieces/manifest.json" Link="models/pieces/manifest.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)docs/licenses/ml/yolox-LICENSE.txt" Link="models/pieces/LICENSE.YOLOX.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(RepoRoot)assets/models/board-corners/board-corners.onnx" Link="models/board-corners/board-corners.onnx"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)assets/models/board-corners/manifest.json" Link="models/board-corners/manifest.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
