<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- DESIGN 17.1: net10.0-windows10.0.26100.0 / win-x64, with a technical compatibility
         floor of 10.0.22000.0 that is not itself a support promise. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>GoldenTicket.Desktop</RootNamespace>
    <AssemblyName>GoldenTicket</AssemblyName>
    <!-- DESIGN 17.1: no trimming, Native AOT, or single-file extraction in the first release. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoldenTicket.Domain\GoldenTicket.Domain.csproj" />
    <ProjectReference Include="..\GoldenTicket.Application\GoldenTicket.Application.csproj" />
    <ProjectReference Include="..\GoldenTicket.AI\GoldenTicket.AI.csproj" />
    <ProjectReference Include="..\GoldenTicket.Persistence\GoldenTicket.Persistence.csproj" />
    <ProjectReference Include="..\GoldenTicket.CompanionHost\GoldenTicket.CompanionHost.csproj" />
    <ProjectReference Include="..\GoldenTicket.Vision\GoldenTicket.Vision.csproj" />
  </ItemGroup>

  <!-- Local experiment weights stay outside source control. Copy only the reviewed deployment
       pair; no training photos, Python environment, or network acquisition enter the app. -->
  <ItemGroup Condition="Exists('$(RepoRoot)artifacts/piece-training/model/piece-detector.onnx')">
    <Content Include="$(RepoRoot)artifacts/piece-training/model/piece-detector.onnx" Link="models/pieces/piece-detector.onnx"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)artifacts/piece-training/model/manifest.json" Link="models/pieces/manifest.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)docs/licenses/ml/yolox-LICENSE.txt" Link="models/pieces/LICENSE.YOLOX.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(RepoRoot)artifacts/board-corners/model/board-corners.onnx')">
    <Content Include="$(RepoRoot)artifacts/board-corners/model/board-corners.onnx" Link="models/board-corners/board-corners.onnx"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)artifacts/board-corners/model/manifest.json" Link="models/board-corners/manifest.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
