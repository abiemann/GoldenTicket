<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>GoldenTicket.Vision</RootNamespace>
    <!-- The package's native-copy target only runs with an explicit PlatformTarget. This library
         remains AnyCPU for development, while the supported desktop/process target is win-x64.
         Copy the production DLL explicitly through project references and omit debug/PDB files. -->
    <Microsoft_AI_DirectML_SkipLibraryCopy>true</Microsoft_AI_DirectML_SkipLibraryCopy>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.D3DCompiler" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <InternalsVisibleTo Include="GoldenTicket.Domain.Tests" />
    <EmbeddedResource Include="Calibration/classic-us-board-320x200.gray" />
    <None Include="../../docs/camera-processing-dependencies.md"
          Link="licenses/camera-processing-dependencies.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/ml-dependencies.md" Link="ml-dependencies.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/licenses/ml/*" Link="licenses/ml/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(Microsoft_AI_DirectML_Bin_Dir_Windows_x64)/DirectML.dll" Link="DirectML.dll"
          Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64'"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckPieceInferenceRuntime" BeforeTargets="PrepareForBuild"
          Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="'$(Microsoft_AI_DirectML_Bin_Dir_Windows_x64)' == '' Or !Exists('$(Microsoft_AI_DirectML_Bin_Dir_Windows_x64)/DirectML.dll')"
           Text="Restore the pinned DirectML package before building the local piece detector." />
  </Target>
</Project>
