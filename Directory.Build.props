<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF resolves a specific culture from XmlLanguage, which invariant globalization cannot do.
         Determinism comes from using CultureInfo.InvariantCulture explicitly where it matters
         (state hashing, the data manifest), not from removing culture data from the runtime. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!-- A self-contained publish applies win-x64 to the entire project-reference graph. Its NuGet
       targets differ from normal development restores, so keep separate committed locks instead
       of rewriting packages.lock.json during packaging. This property must be explicit. -->
  <PropertyGroup Condition="'$(GoldenTicketOfflinePackage)' == 'true'">
    <NuGetLockFilePath>$(MSBuildProjectDirectory)\packages.win-x64.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
